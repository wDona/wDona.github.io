---
import T from '../components/Common/T.astro';
import Head from '../components/Common/Estructura/Head.astro';
import '../styles/global.css';

interface Props {
  keywords?: string | undefined;
  titlePestana?: string;
  description?: string;
  image?: string;
}
const keywords = Astro.props.keywords || "desarrollador, aplicaciones multiplataforma, portfolio, Astro, programación, frontend, backend, wdona, dona, kotlin, jetpack compose, kmp";
const titlePestana = Astro.props.titlePestana || "wDona | Desarrollador de aplicaciones multiplataforma";
const description = Astro.props.description || "Soy un desarrollador de aplicaciones multiplataforma, al que desde pequeño siempre le apasionaba la tecnología y siempre le han atraído los desafíos y las cosas difíciles.";
const image = Astro.props.image;
---

<!doctype html>
<html lang="es">
  <head>
    <Head
    titlePestana={titlePestana}
    keywords={keywords}
    description={description}
    image={image} />
  </head>
  <body>
    <a href="#contenido-principal" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] btn" style="background:rgb(var(--paper))">
      <T es="Saltar al contenido principal" en="Skip to main content" />
    </a>
    <slot />
  </body>
</html>
