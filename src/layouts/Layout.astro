---
import Head from '../components/Common/Head.astro';
import BackgroundAnimado from '../components/Common/BackgroundAnimado.astro';
import '../styles/global.css';


interface Props {
  title: string;
  keywords?: string | undefined;
  titlePestana?: string;
  description?: string;
  image?: string;
}
const title = Astro.props.title;
const keywords = Astro.props.keywords || "desarrollador, aplicaciones multiplataforma, portfolio, Astro, programación, frontend, backend, wdona, dona, miaudona, kotlin, jetpack compose, kmp";
const titlePestana = Astro.props.titlePestana || "wDona | Desarrollador de aplicaciones multiplataforma";
const description = Astro.props.description || "Soy un desarrollador de aplicaciones multiplataforma, al que desde pequeño siempre le apasionaba la tecnología y siempre le han atraído los desafíos y las cosas difíciles.";
const image = Astro.props.image;
---

<!doctype html>
<html lang="es">
  <head>
    <Head 
    title={title}
    titlePestana={titlePestana} 
    keywords={keywords} 
    description={description}
    image={image} />
  </head>
  <body>
    <BackgroundAnimado />
    <slot />
    <script>
      document.documentElement.classList.add('js-ready');

      const io = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const delay = parseInt(el.dataset.revealDelay ?? '0');
          setTimeout(() => el.classList.add('revealed'), delay);
          io.unobserve(el);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -80px 0px' });

      document.querySelectorAll('.reveal').forEach(el => io.observe(el));

      // Fallback: solo revela elementos ya visibles en viewport (no los de abajo del fold)
      setTimeout(() => {
        document.querySelectorAll('.reveal:not(.revealed)').forEach(el => {
          const rect = (el as HTMLElement).getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add('revealed');
          }
        });
      }, 800);
    </script>
  </body>
</html>