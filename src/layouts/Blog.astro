---
import T from "../components/Common/T.astro";
import Footer from "../components/Common/Estructura/Footer.astro";
import Head from "../components/Common/Estructura/Head.astro";
import Nav from "../components/Common/Estructura/Nav.astro";
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  footerText: string;
  footerTextEn?: string;
  keywords?: string;
}
const { title, description, keywords, footerText, footerTextEn } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Head titlePestana={title} keywords={keywords} description={description} />
  </head>
  <body>
    <Nav />
    <main id="contenido-principal" class="wrap py-10 md:py-14">
      <a href="/blogs" class="meta plain"><T es="← Todas las entradas" en="← All posts" /></a>
      <div class="mt-6">
        <slot />
      </div>
    </main>
    <Footer texto={footerText + ' · wDona'} textoEn={footerTextEn && footerTextEn + ' · wDona'} />
  </body>
</html>
