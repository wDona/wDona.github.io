---
import Footer from "../components/Common/Footer.astro";
import Head from "../components/Common/Head.astro";
import '../styles/global.css';

---

<!doctype html>
<html lang="es">
  <head>
    <Head
      title="wDona | Blog"
      titlePestana="Blog de wDona"
      keywords="desarrollador, aplicaciones multiplataforma, portfolio, Astro, programación, frontend, backend, wdona, dona, miaudona, kotlin, jetpack compose, kmp, blog, blogs"
      description="Aqui encontrarás mis blogs y artículos sobre temas diversos, que me apasionan y que espero que te resulten interesantes también."
    />
    <style is:global>
      * {
        font-family: "Zilla Slab", sans-serif;
        font-weight: 400;
        font-style: normal;
      }
    </style>
  </head>
  <body class="zilla-slab-regular">
    <slot />
    <Footer texto="Blog de wDona" />
    <script>
      document.documentElement.classList.add('js-ready');

      const io = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const delay = parseInt(el.dataset.revealDelay ?? '0');
          setTimeout(() => el.classList.add('revealed'), delay);
          io.unobserve(el);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.reveal').forEach(el => io.observe(el));

      setTimeout(() => {
        document.querySelectorAll('.reveal:not(.revealed)').forEach(el => el.classList.add('revealed'));
      }, 1000);
    </script>
  </body>
</html>
