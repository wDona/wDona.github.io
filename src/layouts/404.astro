---
import T from "../components/Common/T.astro";
import Footer from "../components/Common/Estructura/Footer.astro";
import Head from "../components/Common/Estructura/Head.astro";
import Nav from "../components/Common/Estructura/Nav.astro";
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  footerText: string;
  footerTextEn?: string;
  keywords?: string;
}
const { title, description, keywords, footerText, footerTextEn } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Head titlePestana={title} keywords={keywords} description={description} />
  </head>
  <body>
    <Nav />
    <main id="contenido-principal" class="wrap py-16 md:py-24 min-h-[60vh]">
      <h1 class="text-5xl md:text-6xl font-medium">Miau.</h1>
      <p class="meta mt-3"><T es="404 · esta página no existe" en="404 · this page doesn't exist" /></p>
      <p class="mt-8"><a href="/" class="btn"><T es="Ir al inicio" en="Go to the home page" /></a></p>
    </main>
    <Footer texto={footerText} textoEn={footerTextEn} />
  </body>
</html>
