---
import T from "../components/Common/T.astro"
import Layout from "../layouts/Layout.astro"
---

<Layout
    description="Burn't Out es una aplicación diseñada para ayudar a los usuarios a gestionar y prevenir el síndrome de burnout mediante el seguimiento de su bienestar emocional y profesional."
    keywords="Burn't Out, aplicación, síndrome de burnout, bienestar emocional, gestión del estrés"
    titlePestana="Burn't out App"
    image="/img/burntoutlogo.jpg"
>
  <main class="wrap min-h-screen grid place-items-center">
    <p class="meta">
      <T es="Redirigiendo a la última versión…" en="Redirecting to the latest version…" />
      <a href="https://github.com/wDona/Burnt-out/releases"><T es="Abrir a mano" en="Open manually" /></a>
    </p>
  </main>

  <script>
    async function redirectLatestRelease() {
      let url = "https://github.com/wDona/Burnt-out/releases";
      try {
        const releases = await (await fetch("https://api.github.com/repos/wDona/Burnt-out/releases", { cache: "no-store" })).json();
        if (Array.isArray(releases) && releases.length > 0) url = releases[0].html_url;
      } catch (error) {
        console.error("Error al obtener la release:", error);
      }
      window.location.replace(url);
    }

    redirectLatestRelease();
  </script>
</Layout>
