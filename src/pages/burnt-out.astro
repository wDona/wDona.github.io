---
import Layout from "../layouts/Layout.astro"
---

<Layout
    title="Burn't out App"
    description="Burn't Out es una aplicación diseñada para ayudar a los usuarios a gestionar y prevenir el síndrome de burnout mediante el seguimiento de su bienestar emocional y profesional."
    keywords="Burn't Out, aplicación, síndrome de burnout, bienestar emocional, gestión del estrés"
    titlePestana="Burn't out App"
    image="/img/burntoutlogo.png"
>
  <div class="flex items-center justify-center min-h-screen bg-[#080808]">
    <div class="text-white/80 text-xl animate-pulse font-sans">
      Redirigiendo a la última versión...
    </div>
  </div>

  <script>
    async function redirectLatestRelease() {
      try {
        const response = await fetch("https://api.github.com/repos/wDona/Burnt-out/releases", { cache: "no-store" });
        const releases = await response.json();
        
        let url = "https://github.com/wDona/Burnt-out/releases";
        if (releases && releases.length > 0) {
          url = releases[0].html_url;
        }
        
        window.location.replace(url);
      } catch (error) {
        console.error("Error al obtener la release:", error);
        window.location.replace("https://github.com/wDona/Burnt-out/releases");
      }
    }

    redirectLatestRelease();
  </script>
</Layout>