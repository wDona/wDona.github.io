---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Index/Header.astro";
import Nav from "../components/Common/Estructura/Nav.astro";
import Footer from "../components/Common/Estructura/Footer.astro";
import Proyectos from "../components/Index/Proyectos.astro";
import ProyectosDestacados from "../components/Index/ProyectosDestacados.astro";
import SobreMi from "../components/Index/SobreMi.astro";
import Experiencia from "../components/Index/Experiencia.astro";
import Actividad from "../components/Index/Actividad.astro";
---

<Layout titlePestana="wDona" description="Me llamo Fernando. Soy un desarrollador backend centrado en Java y Kotlin. Revisa mis proyectos en esta web. Te invito a que entres a mi GitHub.">
  <Nav />
  <Header />

  <main id="contenido-principal" class="flex flex-col justify-center items-center overflow-x-hidden">
    <div class="max-w-[1200px] flex flex-col justify-center items-center gap-2 sm:gap-6 w-full">
      <!-- <InitialTake/>  -->
      <Experiencia />
      <ProyectosDestacados />
      <Proyectos />
      <SobreMi />
      <Actividad />
    </div>
  </main>

  <Footer texto="Ultima actualización: Mayo 2026 - wDona" />
</Layout>
