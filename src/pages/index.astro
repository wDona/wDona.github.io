  <Header />

  <main class="flex flex-col justify-center items-center overflow-x-hidden">
    <div class="max-w-[1200px] flex flex-col justify-center items-center gap-4 sm:gap-10 w-full">
      <!-- <InitialTake/>  -->
      <Experiencia />
      <Proyectos />
      <SobreMi />
    </div>
  </main>

  <Footer texto="Ultima actualización: Mayo 2026 - wDona" />
</Layout>
