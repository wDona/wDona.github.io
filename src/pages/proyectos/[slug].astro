---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import T from '../../components/Common/T.astro';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Common/Estructura/Nav.astro';
import Footer from '../../components/Common/Estructura/Footer.astro';
import ProjectImage from '../../components/Index/Proyectos/ProjectImage.astro';
import Plataformas from '../../components/Index/Proyectos/Plataformas.astro';
import TechList from '../../components/Index/Proyectos/TechList.astro';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }));
}

type Props = { proyecto: CollectionEntry<'proyectos'> };

const { proyecto } = Astro.props;
const { title, img, cover, tecnologias, plataformas, link, linkdescarga } = proyecto.data;
const { Content } = await render(proyecto);
const en = await getEntry('proyectosEn', proyecto.id);
const ContentEn = en && (await render(en)).Content;
---

<Layout titlePestana={title + " | wDona"}>
  <Nav />
  <main id="contenido-principal" class="wrap py-10 md:py-14">
    <a href="/#proyectos-titulo" id="volver" class="meta plain"><T es="← Todos los proyectos" en="← All projects" /></a>

    <h1 class="mt-4 text-4xl md:text-5xl font-medium"><T es={title} en={en?.data.title} /></h1>

    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
      <TechList tecnologias={tecnologias} />
      <Plataformas plataformas={plataformas} />
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <a href={link} target="_blank" rel="noopener noreferrer" class="btn"><T es="Repositorio" en="Repository" /></a>
      {linkdescarga && (
        <a href={linkdescarga} data-release-repo={link} target="_blank" rel="noopener noreferrer" class="btn">
          <T es="Descargar la última versión" en="Download the latest version" />
        </a>
      )}
    </div>

    {(img || cover) && <ProjectImage img={img} cover={cover} alt={title} class="mt-8 aspect-video max-w-4xl" loading="eager" />}

    <div class="mt-8 prose-wd">
      {ContentEn ? <><div data-l="es"><Content /></div><div data-l="en"><ContentEn /></div></> : <Content />}
    </div>

  </main>
  <Footer texto={`${title} · wDona`} />
</Layout>

<script>
  import { linkLatestReleases } from '../../lib/releases';
  document.addEventListener('astro:page-load', linkLatestReleases);

  // Back to where you were on the previous page (scroll included) if you got here
  // by navigating inside the site; opened directly, the link goes to the projects list.
  document.addEventListener('click', (e) => {
    if (!(window as unknown as { wdNavegado?: boolean }).wdNavegado || !(e.target as HTMLElement).closest?.('#volver')) return;
    e.preventDefault();
    history.back();
  });
</script>
