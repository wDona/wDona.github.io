---
---
<div class="nav-line-wrapper" aria-hidden="true">
  <div class="nav-line"></div>
  <div class="nav-line-shimmer"></div>
</div>

<style>
  .nav-line-wrapper {
    position: relative;
    width: 100%;
    height: 2px;
    overflow: hidden;
  }

  .nav-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(217, 70, 239, 0.15) 15%,
      rgba(217, 70, 239, 0.6) 40%,
      rgba(168, 85, 247, 0.8) 50%,
      rgba(217, 70, 239, 0.6) 60%,
      rgba(217, 70, 239, 0.15) 85%,
      transparent 100%
    );
  }

  .nav-line-shimmer {
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.7),
      transparent
    );
    animation: shimmer 3s ease-in-out infinite;
  }

  @keyframes shimmer {
    0% { left: -60%; }
    100% { left: 160%; }
  }

  :global(html.dark) .nav-line {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(217, 70, 239, 0.1) 15%,
      rgba(217, 70, 239, 0.5) 40%,
      rgba(168, 85, 247, 0.7) 50%,
      rgba(217, 70, 239, 0.5) 60%,
      rgba(217, 70, 239, 0.1) 85%,
      transparent 100%
    );
  }

  :global(html.dark) .nav-line-shimmer {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(217, 70, 239, 0.5),
      transparent
    );
  }
</style>
