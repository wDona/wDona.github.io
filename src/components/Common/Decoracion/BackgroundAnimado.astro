---
---
<div class="bg-animado" aria-hidden="true">
  <div class="orb orb-a"></div>
  <div class="orb orb-b"></div>
  <div class="orb orb-c"></div>
  <div class="stars stars-far"></div>
  <div class="stars stars-near"></div>
  <div class="shooting-star"></div>
  <div class="shooting-star shooting-star-2"></div>
</div>

<style>
  .bg-animado {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  /* ── Drifting color orbs (radial gradients: soft without blur filters) ── */
  .orb {
    position: absolute;
    width: 60vmax;
    aspect-ratio: 1;
    border-radius: 50%;
    opacity: 0.55;
    will-change: transform;
  }
  .orb-a {
    top: -20vmax;
    left: -15vmax;
    background: radial-gradient(closest-side, rgb(var(--c-fuchsia-500) / 0.22), transparent);
    animation: drift-a 38s ease-in-out infinite alternate;
  }
  .orb-b {
    bottom: -25vmax;
    right: -20vmax;
    background: radial-gradient(closest-side, rgb(var(--c-indigo-500) / 0.2), transparent);
    animation: drift-b 46s ease-in-out infinite alternate;
  }
  .orb-c {
    top: 30%;
    left: 40%;
    width: 45vmax;
    background: radial-gradient(closest-side, rgb(var(--c-purple-500) / 0.16), transparent);
    animation: drift-c 32s ease-in-out infinite alternate;
  }
  @keyframes drift-a {
    to { transform: translate(35vw, 25vh) scale(1.2); }
  }
  @keyframes drift-b {
    to { transform: translate(-30vw, -30vh) scale(0.85); }
  }
  @keyframes drift-c {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(-30vw, 10vh) scale(1.25); }
    100% { transform: translate(15vw, -25vh) scale(0.9); }
  }
  /* Light mode: colour is an accent, not a wash — faint, smaller glows */
  :global(html:not(.dark)) .orb { opacity: 1; width: 42vmax; }
  :global(html:not(.dark)) .orb-a { background: radial-gradient(closest-side, rgb(var(--c-fuchsia-500) / 0.07), transparent); }
  :global(html:not(.dark)) .orb-b { background: radial-gradient(closest-side, rgb(var(--c-indigo-500) / 0.07), transparent); }
  :global(html:not(.dark)) .orb-c { background: radial-gradient(closest-side, rgba(113, 113, 122, 0.05), transparent); }
  /* Colour palettes in light mode: a clearly visible atmosphere (mono stays subtle) */
  :global(html:not(.dark):not([data-palette="mono"])) .orb-a { background: radial-gradient(closest-side, rgb(var(--c-fuchsia-400) / 0.22), transparent); }
  :global(html:not(.dark):not([data-palette="mono"])) .orb-b { background: radial-gradient(closest-side, rgb(var(--c-indigo-400) / 0.2), transparent); }
  :global(html:not(.dark):not([data-palette="mono"])) .orb-c { background: radial-gradient(closest-side, rgb(var(--c-purple-400) / 0.14), transparent); }

  /* ── Star layers: tiled, drifting upward at different speeds (parallax) ── */
  .stars {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: calc(100% + 600px);
    will-change: transform;
  }
  .stars-far {
    background-size: 600px 600px;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgb(var(--c-fuchsia-500)/0.4) 50%, transparent 50%),
      radial-gradient(1px 1px at 25% 55%, rgb(var(--c-fuchsia-500)/0.3) 50%, transparent 50%),
      radial-gradient(1px 1px at 55% 70%, rgb(var(--c-fuchsia-500)/0.3) 50%, transparent 50%),
      radial-gradient(1px 1px at 70% 30%, rgb(var(--c-purple-400)/0.4) 50%, transparent 50%),
      radial-gradient(1px 1px at 15% 80%, rgb(var(--c-purple-500)/0.3) 50%, transparent 50%),
      radial-gradient(1px 1px at 60% 45%, rgb(var(--c-fuchsia-500)/0.35) 50%, transparent 50%),
      radial-gradient(1px 1px at 90% 10%, rgb(var(--c-purple-400)/0.4) 50%, transparent 50%),
      radial-gradient(1px 1px at 50% 50%, rgb(var(--c-purple-500)/0.3) 50%, transparent 50%),
      radial-gradient(1px 1px at 75% 85%, rgb(var(--c-fuchsia-500)/0.35) 50%, transparent 50%),
      radial-gradient(1px 1px at 5% 40%, rgb(var(--c-purple-400)/0.4) 50%, transparent 50%),
      radial-gradient(1px 1px at 45% 35%, rgb(var(--c-purple-500)/0.3) 50%, transparent 50%);
    animation: rise 140s linear infinite, twinkle 4s ease-in-out infinite alternate;
  }
  .stars-near {
    background-size: 600px 600px;
    background-image:
      radial-gradient(1.5px 1.5px at 40% 15%, rgb(var(--c-purple-500)/0.6) 50%, transparent 50%),
      radial-gradient(1.5px 1.5px at 85% 60%, rgb(var(--c-fuchsia-500)/0.6) 50%, transparent 50%),
      radial-gradient(2px 2px at 35% 90%, rgb(var(--c-fuchsia-500)/0.5) 50%, transparent 50%),
      radial-gradient(1.5px 1.5px at 95% 75%, rgb(var(--c-fuchsia-500)/0.6) 50%, transparent 50%),
      radial-gradient(2px 2px at 20% 35%, rgb(var(--c-fuchsia-400)/0.5) 50%, transparent 50%),
      radial-gradient(1.5px 1.5px at 65% 5%, rgb(var(--c-purple-400)/0.6) 50%, transparent 50%);
    animation: rise 80s linear infinite, twinkle 3s ease-in-out 1.5s infinite alternate;
  }
  @keyframes rise {
    to { transform: translateY(-600px); }
  }
  @keyframes twinkle {
    0%   { opacity: 0.4; }
    100% { opacity: 1; }
  }
  :global(html.dark) .stars { filter: brightness(1.1); }
  /* Pink specks read as dust on white: keep them barely there */
  :global(html:not(.dark)) .stars { opacity: 0.35 !important; animation-name: rise; }
  :global(html:not(.dark)) .shooting-star { display: none; }

  /* ── Occasional shooting star ── */
  .shooting-star {
    position: absolute;
    top: 12%;
    left: 70%;
    width: 140px;
    height: 1.5px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgb(var(--c-fuchsia-500) / 0.9), transparent);
    opacity: 0;
    transform: rotate(-35deg);
    animation: shoot 11s ease-in 3s infinite;
  }
  .shooting-star-2 {
    top: 40%;
    left: 95%;
    animation-duration: 17s;
    animation-delay: 9s;
  }
  @keyframes shoot {
    0%   { opacity: 0; transform: rotate(-35deg) translateX(0); }
    2%   { opacity: 1; }
    8%   { opacity: 0; transform: rotate(-35deg) translateX(-45vw); }
    100% { opacity: 0; transform: rotate(-35deg) translateX(-45vw); }
  }
</style>
