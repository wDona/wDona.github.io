---
<div class="bg-animado" aria-hidden="true">
  <div class="stars"></div>
</div>

<style>
  .bg-animado {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  /* CSS-only stars via layered radial-gradients */
  .stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(217,70,239,0.4) 50%, transparent 50%),
      radial-gradient(1px 1px at 25% 55%, rgba(217,70,239,0.3) 50%, transparent 50%),
      radial-gradient(1.5px 1.5px at 40% 15%, rgba(168,85,247,0.5) 50%, transparent 50%),
      radial-gradient(1px 1px at 55% 70%, rgba(217,70,239,0.3) 50%, transparent 50%),
      radial-gradient(1px 1px at 70% 30%, rgba(139,92,246,0.4) 50%, transparent 50%),
      radial-gradient(1.5px 1.5px at 85% 60%, rgba(217,70,239,0.5) 50%, transparent 50%),
      radial-gradient(1px 1px at 15% 80%, rgba(168,85,247,0.3) 50%, transparent 50%),
      radial-gradient(1px 1px at 60% 45%, rgba(217,70,239,0.35) 50%, transparent 50%),
      radial-gradient(1px 1px at 90% 10%, rgba(139,92,246,0.4) 50%, transparent 50%),
      radial-gradient(1.5px 1.5px at 35% 90%, rgba(217,70,239,0.45) 50%, transparent 50%),
      radial-gradient(1px 1px at 50% 50%, rgba(168,85,247,0.3) 50%, transparent 50%),
      radial-gradient(1px 1px at 75% 85%, rgba(217,70,239,0.35) 50%, transparent 50%),
      radial-gradient(1px 1px at 5% 40%, rgba(139,92,246,0.4) 50%, transparent 50%),
      radial-gradient(1.5px 1.5px at 95% 75%, rgba(217,70,239,0.5) 50%, transparent 50%),
      radial-gradient(1px 1px at 45% 35%, rgba(168,85,247,0.3) 50%, transparent 50%);
    animation: twinkle 4s ease-in-out infinite alternate;
  }

  @keyframes twinkle {
    0%   { opacity: 0.5; }
    100% { opacity: 1; }
  }

  :global(html.dark) .stars { opacity: 0.7; }
</style>
