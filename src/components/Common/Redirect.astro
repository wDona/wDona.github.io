---
interface Props {
  url: string;
}

const { url } = Astro.props;
---

<html lang="es">
  <head>
    <meta
      http-equiv="refresh"
      content={`0;url=${url}`}
      transition:animate="fade"
      window-target="_blank"
    />
  </head>
  <body></body>
</html>

<style>
  @media (prefers-color-scheme: light) {
    body {
      background-color: white;
      color: black;
    }
  }

  @media (prefers-color-scheme: dark) {
    body {
      background-color: black;
      color: white;
    }
  }

  body {
    margin: 0;
  }
</style>