<a href="#" id="boton-subir" aria-label="Volver arriba" class="opacity-0 pointer-events-none transition-all duration-500 z-50 fixed bottom-4 right-4 sm:bottom-8 sm:right-8 group">
  <div class="h-12 w-12 sm:h-14 sm:w-14 rounded-2xl bg-white dark:bg-white/10 border border-slate-200 dark:border-white/15 flex justify-center items-center hover:bg-fuchsia-50 dark:hover:bg-fuchsia-500/15 hover:border-fuchsia-300 dark:hover:border-fuchsia-500/40 hover:shadow-[0_4px_20px_rgba(217,70,239,0.2)] transition-all duration-300 backdrop-blur-sm">
    <svg 
      xmlns="http://www.w3.org/2000/svg" 
      width="20" 
      height="20" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-width="2.5" 
      stroke-linecap="round" 
      stroke-linejoin="round" 
      class="text-slate-600 dark:text-white/70 group-hover:text-fuchsia-600 dark:group-hover:text-fuchsia-300 group-hover:-translate-y-0.5 transition-all duration-300"
      aria-hidden="true"
    >
      <path d="m18 15-6-6-6 6"/>
    </svg>
  </div>
</a>

<script>
  function manejarScroll() {
    const botonSubir = document.getElementById("boton-subir");
    if (!botonSubir) return;

    if (window.scrollY > 200) {
      botonSubir.classList.remove("opacity-0", "pointer-events-none");
      botonSubir.classList.add("opacity-100");
    } else {
      botonSubir.classList.add("opacity-0", "pointer-events-none");
      botonSubir.classList.remove("opacity-100");
    }
  }

  window.addEventListener("scroll", manejarScroll, { passive: true });
  document.addEventListener("DOMContentLoaded", manejarScroll);
  document.addEventListener("astro:page-load", manejarScroll);
</script>
