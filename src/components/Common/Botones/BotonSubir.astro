<a href="#" id="boton-subir" aria-label="Volver arriba" class="opacity-0 pointer-events-none transition-opacity duration-300 z-50 fixed bottom-4 right-4 sm:bottom-8 sm:right-8">
  <div class="h-12 w-12 sm:h-16 sm:w-16 rounded-xl bg-black border border-white/40 flex justify-center items-center hover:bg-white/10 transition-colors duration-300 group">
    <svg 
      xmlns="http://www.w3.org/2000/svg" 
      width="24" 
      height="24" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-width="2" 
      stroke-linecap="round" 
      stroke-linejoin="round" 
      class="text-white group-hover:-translate-y-1 transition-transform duration-300"
    >
      <path d="m18 15-6-6-6 6"/>
    </svg>
  </div>
</a>

<script>
  function manejarScroll() {
    const botonSubir = document.getElementById("boton-subir");
    if (!botonSubir) return;

    if (window.scrollY > 100) {
      botonSubir.classList.remove("opacity-0", "pointer-events-none");
      botonSubir.classList.add("opacity-100");
    } else {
      botonSubir.classList.add("opacity-0", "pointer-events-none");
      botonSubir.classList.remove("opacity-100");
    }
  }

  // Ejecutar al cargar y al hacer scroll
  window.addEventListener("scroll", manejarScroll);
  document.addEventListener("DOMContentLoaded", manejarScroll);
  
  // Por si utilizas View Transitions de Astro
  document.addEventListener("astro:page-load", manejarScroll);
</script>