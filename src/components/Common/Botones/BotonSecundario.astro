---
interface Props {
    texto: string;
    enlace: string;
    target?: string;
}

const texto = Astro.props.texto;
const enlace = Astro.props.enlace;
const target = Astro.props.target;
---

<a href={enlace}
   target={target || "_blank"}
   class="cursor-pointer bg-fuchsia-100 dark:bg-fuchsia-900/20 border border-fuchsia-300 dark:border-fuchsia-700/30 text-fuchsia-900 dark:text-white px-6 py-2 rounded-lg hover:bg-fuchsia-200 dark:hover:bg-fuchsia-800/40 hover:border-fuchsia-400 dark:hover:border-fuchsia-500/50 hover:-translate-y-1 hover:shadow-[0_0_10px_rgba(217,70,239,0.1)] dark:hover:shadow-[0_0_10px_rgba(217,70,239,0.2)] transition-all duration-300 w-full sm:w-auto text-center font-medium backdrop-blur-sm">
   {texto}
</a>