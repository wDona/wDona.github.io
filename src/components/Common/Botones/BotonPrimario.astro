---
interface Props {
  texto: string;
  enlace: string;
  target?: string;
  id?: string;
}
const texto = Astro.props.texto;
const enlace = Astro.props.enlace;
const target = Astro.props.target || "_blank";
const id = Astro.props.id;
---

<a
  href={enlace}
  id={id}
  class="zilla-slab-regular bg-fuchsia-800/80 text-white border border-fuchsia-700/50 backdrop-blur-sm px-4 py-3 sm:px-6 sm:py-3 rounded-lg hover:bg-fuchsia-500 hover:border-fuchsia-400 hover:-translate-y-1 hover:shadow-[0_0_25px_rgba(217,70,239,0.7)] transition-all duration-300 text-center w-full block text-lg sm:text-xl"
  target={target}
>
  {texto}
</a>
