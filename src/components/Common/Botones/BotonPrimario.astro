---
interface Props {
  texto: string;
  enlace: string;
  target?: string;
  id?: string;
}
const texto = Astro.props.texto;
const enlace = Astro.props.enlace;
const target = Astro.props.target || "_blank";
const id = Astro.props.id;
---

<a
  href={enlace}
  id={id}
  class="btn btn-primary w-full"
  target={target}
>
  {texto}
</a>
