---
import T from "../T.astro";
interface Props {
  texto: string;
  textoEn?: string;
  enlace: string;
  target?: string;
  id?: string;
}
const { texto, textoEn, enlace, id, target = "_blank" } = Astro.props;
---

<a href={enlace} id={id} class="btn" target={target} rel={target === "_blank" ? "noopener noreferrer" : undefined}>
  <T es={texto} en={textoEn} />
</a>
