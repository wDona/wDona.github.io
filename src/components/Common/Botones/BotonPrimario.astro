---
import T from "../T.astro";
interface Props {
  texto: string;
  textoEn?: string;
  enlace: string;
  target?: string;
  id?: string;
}
const { texto, textoEn } = Astro.props;
const enlace = Astro.props.enlace;
const target = Astro.props.target || "_blank";
const id = Astro.props.id;
---

<a
  href={enlace}
  id={id}
  class="btn btn-primary w-full"
  target={target}
>
  <T es={texto} en={textoEn} />
</a>
