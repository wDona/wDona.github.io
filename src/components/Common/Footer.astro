---
import Contacto from '../Index/Contacto.astro';


interface Props {
  texto: string;
}
const { texto } = Astro.props;
---

<footer class="w-full py-12">
  <div class="lg:w-[700px] sm:w-[90%] w-[98%] mx-auto flex flex-col sm:flex-row justify-between items-center gap-6 px-4 sm:px-12 md:px-4">
    <Contacto/>
  </div>
  <div
    class="lg:w-[700px] sm:w-[90%] w-[98%] mx-auto flex flex-col sm:flex-row justify-between items-center gap-6 px-4 sm:px-12 md:px-4"
  >
    <p class="zilla-slab-regular text-center sm:text-left">
      {texto}
    </p>
    <div class="flex gap-4">
      <a href="/github"
        ><img src="/img/github.svg" alt="GitHub" class="w-12 h-12" />
      </a>
      <a href="/"
        ><img src="/img/Gato_D.png" alt="Web" class="w-12 h-12" />
      </a>
    </div>
  </div>
</footer>

<style>
  p {
    margin-top: 0;
  }
</style>
