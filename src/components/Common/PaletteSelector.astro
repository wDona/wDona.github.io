---
const paletas = [
  { id: "mono", label: "Monocromo", swatch: "linear-gradient(135deg, #fafafa 0%, #fafafa 50%, #18181b 50%, #18181b 100%)" },
  { id: "fucsia", label: "Fucsia", swatch: "linear-gradient(135deg, #f0abfc, #d946ef 45%, #6366f1)" },
  { id: "sky", label: "Sky", swatch: "linear-gradient(135deg, #bae6fd, #0ea5e9 45%, #6366f1)" },
];
---
<div class="palette-selector relative">
  <button
    type="button"
    class="palette-trigger group flex h-10 w-10 items-center justify-center rounded-full transition-all duration-300 hover:scale-110 hover:bg-slate-100 dark:hover:bg-white/10"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="Paleta de colores"
    title="Paleta de colores"
  >
    <span class="palette-current block h-6 w-6 rounded-full ring-2 ring-white dark:ring-white/10 shadow-[0_2px_8px_rgba(0,0,0,0.25)] transition-transform duration-500 group-hover:rotate-180"></span>
  </button>

  <div class="palette-panel absolute right-0 top-full z-50 mt-3 w-60 rounded-2xl border border-slate-200 bg-white/95 p-2 shadow-[0_20px_50px_-12px_rgba(15,23,42,0.25)] backdrop-blur-xl dark:border-white/10 dark:bg-[rgba(14,12,20,0.95)] dark:shadow-[0_20px_50px_-12px_rgba(0,0,0,0.7)]" role="menu">
    {paletas.map(p => (
      <button
        type="button"
        role="menuitemradio"
        aria-checked="false"
        data-palette-option={p.id}
        class="palette-option flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left transition-colors duration-200 hover:bg-slate-100 dark:hover:bg-white/5"
      >
        <span class="block h-8 w-8 flex-shrink-0 rounded-full ring-1 ring-black/10 dark:ring-white/15 shadow-sm" style={`background:${p.swatch}`} data-swatch={p.swatch}></span>
        <span class="flex-1 text-base text-slate-700 dark:text-white/85">{p.label}</span>
        <svg class="palette-check h-5 w-5 text-slate-900 dark:text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
      </button>
    ))}
  </div>
</div>

<style>
  .palette-panel {
    opacity: 0;
    transform: translateY(-6px) scale(0.96);
    transform-origin: top right;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .palette-selector.open .palette-panel {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .palette-check {
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .palette-option[aria-checked="true"] .palette-check {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  type ThemeWindow = { wdApplyTheme: () => void; wdTransition: (e: MouseEvent, fn: () => void, kind?: string) => void };
  const w = window as unknown as ThemeWindow;

  // Nav persists across pages, so one set of listeners covers every instance
  const setOpen = (sel: Element, open: boolean) => {
    sel.classList.toggle('open', open);
    sel.querySelector('.palette-trigger')?.setAttribute('aria-expanded', String(open));
  };
  const closeAll = () => document.querySelectorAll('.palette-selector.open').forEach(s => setOpen(s, false));

  const sync = () => {
    const current = document.documentElement.dataset.palette;
    document.querySelectorAll<HTMLElement>('[data-palette-option]').forEach(b => {
      const active = b.dataset.paletteOption === current;
      b.setAttribute('aria-checked', String(active));
      if (active) {
        const swatch = b.querySelector<HTMLElement>('[data-swatch]')!.dataset.swatch!;
        b.closest('.palette-selector')!.querySelector<HTMLElement>('.palette-current')!.style.background = swatch;
      }
    });
  };

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const trigger = target.closest?.('.palette-trigger');
    if (trigger) {
      const sel = trigger.closest('.palette-selector')!;
      const open = !sel.classList.contains('open');
      closeAll();
      setOpen(sel, open);
      return;
    }
    const option = target.closest?.('[data-palette-option]') as HTMLElement | null;
    if (option) {
      closeAll();
      w.wdTransition(e as MouseEvent, () => {
        localStorage.setItem('palette', option.dataset.paletteOption!);
        w.wdApplyTheme();
      });
      return;
    }
    if (!target.closest?.('.palette-panel')) closeAll();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
  document.addEventListener('themechange', sync);
  document.addEventListener('astro:page-load', sync);
  sync();
</script>
