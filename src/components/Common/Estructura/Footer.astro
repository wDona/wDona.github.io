---
import Contacto from '../../Index/Contacto.astro';

interface Props {
  texto: string;
}
const { texto } = Astro.props;
---

<footer class="w-full py-12 border-t-[1px] border-fuchsia-200/50 dark:border-fuchsia-900/30 bg-white/30 dark:bg-black/30 backdrop-blur-md" id="footer">
  <div class="lg:w-[900px] sm:w-[90%] w-[98%] mx-auto flex flex-col items-center gap-6 px-4 relative">
    <Contacto/>
  </div>
  <div
    class="lg:w-[900px] sm:w-[90%] w-[98%] mx-auto flex flex-col sm:flex-row justify-between items-center gap-6 px-4 mt-8 pt-8 border-t-[1px] border-slate-200/50 dark:border-white/5 reveal"
    data-reveal-delay="200"
  >
    <p class="zilla-slab-regular text-center sm:text-left text-slate-500 dark:text-white/40 text-sm">
      {texto}
    </p>
    <nav aria-label="Redes sociales" class="flex gap-4">
      <a href="https://github.com/MiauDona" target="_blank" rel="noopener noreferrer"
        class="hover:scale-110 hover:-translate-y-1 hover:drop-shadow-[0_0_15px_rgba(217,70,239,0.5)] transition-all duration-300"
        aria-label="Perfil de GitHub (abre en nueva pestaña)"
      >
        <img src="/img/github.svg" alt="" class="w-10 h-10 invert dark:invert-0 opacity-60 hover:opacity-100 transition-opacity" loading="lazy" aria-hidden="true" width="40" height="40" />
      </a>
      <a href="/"
        class="hover:scale-110 hover:-translate-y-1 hover:drop-shadow-[0_0_15px_rgba(217,70,239,0.5)] transition-all duration-300"
        aria-label="Ir al inicio"
      >
        <img src="/img/Gato_D.png" alt="" class="w-10 h-10 invert dark:invert-0 opacity-60 hover:opacity-100 transition-opacity" loading="lazy" aria-hidden="true" width="40" height="40" />
      </a>
    </nav>
  </div>
</footer>
