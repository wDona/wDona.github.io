---
import T from '../T.astro';
import Contacto from '../../Index/Contacto.astro';

interface Props {
  texto: string;
  textoEn?: string;
}
const { texto, textoEn } = Astro.props;
---

<footer class="band-soft mt-8" id="footer"><div class="wrap">
  <Contacto />
  <div class="rule-t flex flex-wrap items-center justify-between gap-4 py-6 meta">
    <p><T es={texto} en={textoEn} /></p>
    <nav aria-label="Redes sociales" data-en-aria-label="Social links" class="flex items-center gap-5">
      <a href="https://github.com/wDona" target="_blank" rel="noopener noreferrer" aria-label="Perfil de GitHub (abre en nueva pestaña)" data-en-aria-label="GitHub profile (opens in a new tab)">GitHub</a>
      <a href="/" class="inline-flex" aria-label="Ir al inicio" data-en-aria-label="Go to home">
        <img src="/img/Gato_D-sm.webp" alt="" class="w-7 h-7 invert dark:invert-0" loading="lazy" aria-hidden="true" width="28" height="28" />
      </a>
    </nav>
  </div>
</div></footer>
