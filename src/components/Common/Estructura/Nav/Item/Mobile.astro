---
import LineaSeparadoraHorizontal from "../../../Decoracion/LineaSeparadoraHorizontal.astro";

interface Props {
    enlace: string;
    texto: string;
}

const { enlace, texto } = Astro.props;
---

<a href={enlace} class="block group">
      <li class="py-4 group-hover:bg-fuchsia-900/20 transition-colors duration-300 w-full"><p class="zilla-slab-regular group-hover:text-fuchsia-400 group-hover:scale-105 transition-all duration-300 w-full inline-block">{texto}</p></li>
    </a>
    <LineaSeparadoraHorizontal />

<style>
  p {
    margin: 0;
  }
</style>
