---
import ThemeToggle from "../../ThemeToggle.astro";
import PaletteSelector from "../../PaletteSelector.astro";
---
<div class="items-center gap-8 hidden md:flex">
  <a href="/" class="hover:scale-110 hover:drop-shadow-[0_0_15px_rgb(var(--c-fuchsia-500)/0.5)] transition-all duration-300" aria-label="Ir al inicio">
    <img src="/img/Logo_MD.png" alt="" class="w-20 logo-cats" aria-hidden="true" />
  </a>
  <div class="md:flex items-center md:gap-6">
    <a href="/" class="transition-colors duration-300 zilla-slab-regular relative group hover:text-fuchsia-400 py-1">
      Inicio
      <span class="absolute bottom-0 left-0 w-full h-[2px] bg-fuchsia-400 rounded-full origin-center scale-x-0 group-hover:scale-x-100 group-focus-visible:scale-x-100 transition-transform duration-300" aria-hidden="true"></span>
    </a>
    <a
      href="/blogs"
      class="transition-colors duration-300 zilla-slab-regular relative group hover:text-fuchsia-400 py-1"
    >
      Blogs
      <span class="absolute bottom-0 left-0 w-full h-[2px] bg-fuchsia-400 rounded-full origin-center scale-x-0 group-hover:scale-x-100 group-focus-visible:scale-x-100 transition-transform duration-300" aria-hidden="true"></span>
    </a>
    <a
      href="#contacto"
      class="transition-colors duration-300 zilla-slab-regular relative group hover:text-fuchsia-400 py-1"
    >
      Contacto
      <span class="absolute bottom-0 left-0 w-full h-[2px] bg-fuchsia-400 rounded-full origin-center scale-x-0 group-hover:scale-x-100 group-focus-visible:scale-x-100 transition-transform duration-300" aria-hidden="true"></span>
    </a>
  </div>
</div>

<div class="hidden md:flex gap-2 items-center">
  <PaletteSelector />
  <ThemeToggle />
  <a href="/github" target="_blank" class="hover:scale-110 hover:-translate-y-1 hover:drop-shadow-[0_0_15px_rgb(var(--c-fuchsia-500)/0.5)] transition-all duration-300"
    aria-label="Perfil de GitHub"
    rel="noopener noreferrer"
  >
    <img src="/img/github.svg" alt="" class="w-12 brightness-0 dark:invert" aria-hidden="true" />
  </a>
</div>

