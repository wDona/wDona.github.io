---
import LineaSeparadoraHorizontal from "../../Decoracion/LineaSeparadoraHorizontal.astro";
import ItemNavMobile from "./Item/Mobile.astro";
import ThemeToggle from "../../ThemeToggle.astro";
---

<div class="md:hidden flex items-center justify-between w-full">
  <div class="md:hidden flex items-center gap-2">
    <button
      id="menu-toggle"
      class="flex items-center min-w-[44px] min-h-[44px] justify-center"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir menú de navegación"
    >
      <img src="/img/menu.svg" alt="" class="w-12 md:w-20 lg:w-24 invert dark:invert-0" aria-hidden="true" />
    </button>
  
    <div>
      <p class="text-3xl">Menú</p>
    </div>
  </div>

  <a href="/" class="hover:scale-110 hover:drop-shadow-[0_0_15px_rgb(var(--c-fuchsia-500)/0.5)] transition-all duration-300" aria-label="Ir al inicio">
    <img src="/img/Logo_MD.png" alt="" class="w-16 invert dark:invert-0" aria-hidden="true" />
  </a>
</div>

<div
  id="mobile-menu"
  class="md:hidden w-full flex flex-col items-center gap-12 fixed top-20 z-50 h-[100vh] -translate-x-full left-0 opacity-0 transition-all duration-200 bg-white/95 dark:bg-black/95 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <ul class="w-full text-center">
    <LineaSeparadoraHorizontal />
    <ItemNavMobile enlace="/" texto="Inicio" />
    <ItemNavMobile enlace="/blogs" texto="Blogs" />
  </ul>
  <div class="flex gap-6 items-center">
    <ThemeToggle />
    <!-- <a href="/youtube" target="_blank"
      ><img src="/img/youtube.svg" alt="YT" class="w-12" />
    </a> -->
    <a href="/github" target="_blank" class="hover:scale-110 hover:-translate-y-1 hover:drop-shadow-[0_0_15px_rgb(var(--c-fuchsia-500)/0.5)] transition-all duration-300"
      ><img src="/img/github.svg" alt="Git" class="w-12 brightness-0 dark:brightness-100" />
    </a> 
    <!--<a href="/discord" target="_blank"
      ><img src="/img/discordlogo.webp" alt="DC" class="w-10" />
    </a> -->
  </div>
</div>

<script>
  const toggleButton = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const isOpen = () => menu.classList.contains("translate-x-0");

  function setMenu(open: boolean) {
    menu.classList.toggle("translate-x-0", open);
    menu.classList.toggle("opacity-100", open);
    menu.classList.toggle("-translate-x-full", !open);
    menu.classList.toggle("opacity-0", !open);
    toggleButton.setAttribute("aria-expanded", String(open));
    toggleButton.setAttribute("aria-label", open ? "Cerrar menú de navegación" : "Abrir menú de navegación");
    document.body.style.overflow = open ? "hidden" : "";
    if (open) menu.querySelector("a")?.focus();
  }

  toggleButton.addEventListener("click", () => setMenu(!isOpen()));

  // Close with Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) {
      setMenu(false);
      toggleButton.focus();
    }
  });

  // Close when clicking outside
  document.addEventListener("click", (e) => {
    const t = e.target as Node;
    if (isOpen() && !menu.contains(t) && !toggleButton.contains(t)) setMenu(false);
  });

  // Nav persists across pages: close the menu after navigating
  document.addEventListener("astro:after-swap", () => { if (isOpen()) setMenu(false); });
</script>

<style>
  p {
    margin-top: 0;
  }
</style>
