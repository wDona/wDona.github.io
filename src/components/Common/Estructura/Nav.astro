---
import LineaSeparadoraHorizontal from "../Decoracion/LineaSeparadoraHorizontal.astro";
import MobileNav from "./Nav/Mobile.astro";
import DesktopNav from "./Nav/Desktop.astro";
import BotonSubir from "../Botones/BotonSubir.astro";
---

<div id="scroll-progress" aria-hidden="true" transition:persist="scroll-progress"></div>
<nav
  aria-label="Navegación principal"
  data-en-aria-label="Main navigation"
  id="main-nav"
  transition:persist="main-nav"
  class="text-slate-900 dark:text-white text-xl sm:text-2xl h-20 fixed top-0 w-full z-50 flex items-center justify-center flex-col px-4 animate-fade-in-up animation-delay-300 transition-all duration-500 bg-white/70 dark:bg-black/80 backdrop-blur-xl"
>
  <div class="lg:flex lg:justify-center items-center w-full">
    <div
      class="flex justify-between items-center lg:w-[900px] sm:w-[90%] w-[98%] sm:px-[10%] lg:px-0 lg:margin-auto"
    >
      <DesktopNav />
      <MobileNav />
    </div>
  </div>
</nav>
<div class="fixed top-20 w-full z-50 animate-fade-in-up animation-delay-300" transition:persist="nav-line">
  <LineaSeparadoraHorizontal />
</div>

<BotonSubir />

<script>
  window.addEventListener('scroll', () => {
    document.getElementById('main-nav')?.classList.toggle('nav-scrolled', window.scrollY > 50);
  }, { passive: true });
</script>

<style>
  :global(.nav-scrolled) {
    box-shadow: 0 1px 20px rgb(var(--c-fuchsia-500) / 0.08);
  }
  :global(html.dark) :global(.nav-scrolled) {
    box-shadow: 0 1px 20px rgb(var(--c-fuchsia-500) / 0.12);
  }
</style>
