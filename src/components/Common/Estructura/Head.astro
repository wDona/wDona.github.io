---
import { ClientRouter } from 'astro:transitions';
import '../../../styles/global.css';

interface Props {
    titlePestana: string;
    keywords?: string;
    description?: string;
    image?: string;
}

const { titlePestana, keywords, description, image = "/img/Gato_D.png" } = Astro.props;
const canonicalURL = `https://wdona.dev${Astro.url.pathname}`;
const absoluteImage = image.startsWith('http') ? image : `https://wdona.dev${image}`;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="author" content="wDona" />
<meta name="keywords" content={keywords} />
<meta name="robots" content="index, follow, max-snippet:150, max-image-preview:large" />
<meta name="description" content={description} />
<meta name="theme-color" content="#f6f1e1" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1b1614" media="(prefers-color-scheme: dark)" />

<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/png" href="/img/Gato_D-icon.png" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="wDona" />
<meta property="og:title" content={titlePestana} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content="es_ES" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titlePestana} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

<!-- JSON-LD -->
<script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Fernando M. de Cisneros González",
    "alternateName": ["wDona", "YoSoyDona", "Dona"],
    "url": "https://wdona.dev/",
    "image": "https://wdona.dev/img/Gato_D.png",
    "jobTitle": "Desarrollador de aplicaciones multiplataforma",
    "description": "Portfolio de proyectos personales y profesionales en desarrollo multiplataforma. Especializado en Kotlin, Java y frameworks modernos.",
    "sameAs": [
      "https://github.com/wDona",
      "https://www.linkedin.com/in/wdona"
    ],
    "knowsAbout": ["Kotlin", "Java", "Jetpack Compose", "Ktor", "Android Development", "Web Development"],
    "hasOccupation": {
      "@type": "Occupation",
      "name": "Desarrollador de aplicaciones multiplataforma",
      "occupationLocation": {
        "@type": "Country",
        "name": "España"
      }
    }
  }
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Zilla+Slab:wght@500;600&display=swap" rel="stylesheet">

<script is:inline>
  // Theme (light/dark) + accent (bermellon/pino/mostaza/tinta). First visit: the system theme.
  // Each mode keeps its own accent (palette-light / palette-dark); default: mostaza in light, tinta in dark.
  function applyTheme(doc) {
    const stored = localStorage.getItem('theme');
    const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const storedPalette = localStorage.getItem(dark ? 'palette-dark' : 'palette-light');
    const palette = ['bermellon', 'pino', 'mostaza', 'tinta'].includes(storedPalette) ? storedPalette : (dark ? 'tinta' : 'mostaza');
    doc.documentElement.classList.toggle('dark', dark);
    doc.documentElement.dataset.palette = palette;
    if (doc === document) document.dispatchEvent(new CustomEvent('themechange', { detail: { dark, palette } }));
  }
  window.wdApplyTheme = () => applyTheme(document);

  // Language (es/en): text comes in both languages and CSS hides the other one
  // by <html lang>; translated attributes live in data-en-* (Spanish is saved in data-es-*).
  // First visit: Spanish if the browser is in Spanish, English otherwise.
  function applyLang(doc) {
    const lang = localStorage.getItem('lang') || (navigator.language.startsWith('es') ? 'es' : 'en');
    doc.documentElement.lang = lang;
    for (const a of ['aria-label', 'title', 'alt']) {
      doc.querySelectorAll(`[data-en-${a}]`).forEach((el) => {
        if (!el.hasAttribute(`data-es-${a}`)) el.setAttribute(`data-es-${a}`, el.getAttribute(a) ?? '');
        el.setAttribute(a, el.getAttribute(`data-${lang}-${a}`));
      });
    }
  }
  window.wdApplyLang = () => applyLang(document);

  applyTheme(document);
  applyLang(document);
  document.addEventListener('DOMContentLoaded', () => applyLang(document));
  // Keep theme and language when the client router swaps in a new page
  document.addEventListener('astro:before-swap', (e) => { applyTheme(e.newDocument); applyLang(e.newDocument); });
  // Remember that the visitor moved inside the site (project pages use it for their back link)
  document.addEventListener('astro:after-swap', () => { window.wdNavegado = true; });
</script>
<ClientRouter />
<title>{titlePestana}</title>
