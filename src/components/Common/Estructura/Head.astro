---
import { ClientRouter } from 'astro:transitions';
import '../../../styles/global.css';

interface Props {
    titlePestana: string;
    keywords?: string;
    description?: string;
    image?: string;
}

const { titlePestana, keywords, description, image = "/img/Gato_D.png" } = Astro.props;
const canonicalURL = `https://wdona.dev${Astro.url.pathname}`;
const absoluteImage = image.startsWith('http') ? image : `https://wdona.dev${image}`;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="author" content="wDona" />
<meta name="keywords" content={keywords} />
<meta name="robots" content="index, follow, max-snippet:150, max-image-preview:large" />
<meta name="description" content={description} />
<meta name="theme-color" content="rgb(var(--c-fuchsia-500))" />

<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/png" href="/img/Gato_D.png" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="wDona" />
<meta property="og:title" content={titlePestana} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content="es_ES" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titlePestana} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

<!-- JSON-LD -->
<script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Fernando M. de Cisneros González",
    "alternateName": ["wDona", "MiauDona", "YoSoyDona", "Dona"],
    "url": "https://wdona.dev/",
    "image": "https://wdona.dev/img/Gato_D.png",
    "jobTitle": "Desarrollador de aplicaciones multiplataforma",
    "description": "Portfolio de proyectos personales y profesionales en desarrollo multiplataforma. Especializado en Kotlin, Java y frameworks modernos.",
    "sameAs": [
      "https://github.com/MiauDona",
      "https://www.linkedin.com/in/wdona"
    ],
    "knowsAbout": ["Kotlin", "Java", "Jetpack Compose", "Ktor", "Android Development", "Web Development"],
    "hasOccupation": {
      "@type": "Occupation",
      "name": "Desarrollador de aplicaciones multiplataforma",
      "occupationLocation": {
        "@type": "Country",
        "name": "España"
      }
    }
  }
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@300;400&display=swap" rel="stylesheet">

<script is:inline>
  // Theme (light/dark) + accent palette (mono/fucsia/sky). First visit: dark + fucsia.
  // Without a stored palette: mono in light mode, fucsia in dark mode.
  function applyTheme(doc) {
    const stored = localStorage.getItem('theme');
    const dark = stored ? stored === 'dark' : true; // first visit: dark
    const palette = localStorage.getItem('palette') || (dark ? 'fucsia' : 'mono');
    doc.documentElement.classList.toggle('dark', dark);
    doc.documentElement.dataset.palette = palette;
    if (doc === document) document.dispatchEvent(new CustomEvent('themechange', { detail: { dark, palette } }));
  }
  window.wdApplyTheme = () => applyTheme(document);
  // Run a theme/palette change with a circular reveal from the click point
  window.wdTransition = (event, change) => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reduce || !event) { change(); return; }
    const x = event.clientX || innerWidth / 2, y = event.clientY || 0;
    const root = document.documentElement;
    root.style.setProperty('--vt-x', x + 'px');
    root.style.setProperty('--vt-y', y + 'px');
    root.style.setProperty('--vt-r', Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)) + 'px');
    root.classList.add('theme-vt');
    document.startViewTransition(change).finished.finally(() => root.classList.remove('theme-vt'));
  };
  applyTheme(document);
  // Keep theme when the client router swaps in a new page
  document.addEventListener('astro:before-swap', (e) => applyTheme(e.newDocument));
</script>
<ClientRouter />
<title>{titlePestana}</title>

<script>
  document.documentElement.classList.add('js-ready');

  // Reveal on scroll (re-armed on every client-side navigation)
  const io = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      setTimeout(() => el.classList.add('revealed'), parseInt(el.dataset.revealDelay ?? '0'));
      io.unobserve(el);
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
  document.addEventListener('astro:before-swap', (e) => {
    e.newDocument.documentElement.classList.add('js-ready');
  });
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.reveal:not(.revealed)').forEach(el => io.observe(el));
  });

  // Cursor spotlight on cards
  document.addEventListener('pointermove', (e) => {
    const card = (e.target as HTMLElement).closest?.('.card, .spotlight') as HTMLElement | null;
    if (!card) return;
    const r = card.getBoundingClientRect();
    card.style.setProperty('--mx', `${e.clientX - r.left}px`);
    card.style.setProperty('--my', `${e.clientY - r.top}px`);
  }, { passive: true });

  // Scroll progress bar
  const updateProgress = () => {
    const bar = document.getElementById('scroll-progress');
    if (!bar) return;
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
  };
  addEventListener('scroll', updateProgress, { passive: true });
  document.addEventListener('astro:page-load', updateProgress);
</script>
