<button
  type="button"
  class="lang-toggle hover:scale-110 transition-all duration-300 flex items-center justify-center gap-1 p-2 rounded-full hover:bg-gray-200 dark:hover:bg-zinc-800 text-base font-semibold"
  aria-label="Switch to English"
  data-en-aria-label="Cambiar a español"
  title="Switch to English"
  data-en-title="Cambiar a español"
>
  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
  </svg>
  <span aria-hidden="true"><span data-l="es">ES</span><span data-l="en">EN</span></span>
</button>

<script>
  type LangWindow = { wdApplyLang: () => void; wdTransition: (e: MouseEvent, fn: () => void, kind?: string) => void };
  const w = window as unknown as LangWindow;

  // Nav persists across pages, so one listener covers every instance
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest?.('.lang-toggle')) return;
    w.wdTransition(e, () => {
      localStorage.setItem('lang', document.documentElement.lang === 'en' ? 'es' : 'en');
      w.wdApplyLang();
    });
  });
</script>
