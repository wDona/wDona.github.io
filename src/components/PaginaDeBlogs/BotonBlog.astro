---
interface Props {
  texto: string;
  enlace: string;
}
const { texto, enlace } = Astro.props;
---

<a
  href={enlace}
  class="zilla-slab-regular flex items-center justify-center bg-fuchsia-800/40 border-[1px] border-fuchsia-800/30 text-white px-6 py-8 rounded-xl hover:bg-fuchsia-800 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(134,25,143,0.5)] transition-all duration-300 text-center w-full shadow-md text-xl md:text-2xl h-full backdrop-blur-sm"
>
  {texto}
</a>