---
interface Props {
  texto: string;
  enlace: string;
}
const { texto, enlace } = Astro.props;
---

<a
  href={enlace}
  class="card zilla-slab-regular flex items-center justify-center !rounded-2xl px-6 py-8 text-center w-full text-xl md:text-2xl h-full text-slate-800 dark:text-white hover:text-fuchsia-700 dark:hover:text-fuchsia-200"
>
  {texto}
</a>