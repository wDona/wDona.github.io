---
import Habilidad from "./Habilidades/Habilidad.astro";
---

<section class="xl:w-[1200px] sm:w-[90%] w-[98%] py-16 mx-auto" aria-labelledby="habilidades-titulo">
  <h2 id="habilidades-titulo" class="text-4xl md:text-5xl zilla-slab-regular mb-8 text-center tracking-tight reveal text-slate-800 dark:text-white">Habilidades</h2>
  <div
    class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-5 lg:grid-cols-9 zilla-slab-regular content-center items-center mb-6 relative sm:gap-y-4 gap-4 mx-8 sm:mx-0 reveal"
    data-reveal-delay="150"
  >
    <Habilidad img="img/astrologo.webp" title="Astro" />
    <Habilidad img="img/kotlinlogo.webp" title="Kotlin" />
    <Habilidad img="img/jetpackcomposelogo.webp" title="Compose" />
    <Habilidad img="img/ktorlogo.webp" title="Ktor" />
    <Habilidad img="img/github.svg" title="GitHub" />
    <Habilidad img="img/javalogo.webp" title="Java" />
    <Habilidad img="img/CSS3_logo.webp" title="CSS3" />
    <Habilidad img="img/HTML5_logo.png" title="HTML5" />
    <Habilidad img="img/javafxlogo.webp" title="JavaFX" />
    
  </div>
</section>
