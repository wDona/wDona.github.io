---
import T from "../../Common/T.astro";
---
<div id="countdown-cumple">
  <p class="text-[0.95rem]">
    <T es="16 de diciembre." en="December 16." />
    <span class="countdown-left">
      <T es="Faltan" en="Coming in" />
      <span class="meta !text-[0.95rem] tabular-nums" id="countdown-text" role="timer" aria-live="off">--</span>
    </span>
    <span id="countdown-hoy" hidden><T es="Es hoy." en="It's today." /></span>
  </p>
  <div class="bar mt-2 max-w-xs" aria-hidden="true"><div id="countdown-progress"></div></div>
</div>

<style>
  .bar { height: 3px; background: rgb(var(--rule)); }
  #countdown-progress { height: 100%; width: 0; background: rgb(var(--accent)); }
</style>

<script>
  function updateCountdown() {
    const text = document.getElementById('countdown-text');
    if (!text) return;

    const now = new Date();
    let target = new Date(now.getFullYear(), 11, 16);

    if (now.getMonth() === 11 && now.getDate() === 16) {
      document.querySelector<HTMLElement>('.countdown-left')!.hidden = true;
      document.getElementById('countdown-hoy')!.hidden = false;
      return;
    }
    if (now > target) target = new Date(now.getFullYear() + 1, 11, 16);

    const diff = target.getTime() - now.getTime();
    const pad = (n: number) => String(n).padStart(2, '0');
    const d = Math.floor(diff / 86400000);
    const h = Math.floor(diff / 3600000) % 24;
    const m = Math.floor(diff / 60000) % 60;
    const s = Math.floor(diff / 1000) % 60;
    text.textContent = `${d}d ${pad(h)}h ${pad(m)}m ${pad(s)}s`;

    // Progress through the year since the last birthday
    const last = new Date(target.getFullYear() - 1, 11, 16);
    const pct = ((now.getTime() - last.getTime()) / (target.getTime() - last.getTime())) * 100;
    document.getElementById('countdown-progress')!.style.width = `${pct.toFixed(2)}%`;
  }

  let timer: ReturnType<typeof setInterval> | undefined;
  document.addEventListener('astro:page-load', () => {
    clearInterval(timer);
    if (!document.getElementById('countdown-cumple')) return;
    updateCountdown();
    timer = setInterval(updateCountdown, 1000);
  });
</script>
