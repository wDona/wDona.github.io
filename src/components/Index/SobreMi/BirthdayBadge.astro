---
import T from "../../Common/T.astro";
const unidades = [
  { id: "d", label: "d" },
  { id: "h", label: "h" },
  { id: "m", label: "m" },
  { id: "s", label: "s" },
];
---
<article class="card group h-full col-span-1 p-6 text-center flex flex-col justify-center items-center gap-3.5">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="cake-icon block h-9 w-9" fill="none" stroke="url(#cake-grad)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <defs>
      <linearGradient id="cake-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="24" y2="24">
        <stop offset="0" style="stop-color:rgb(var(--c-fuchsia-500))" />
        <stop offset="0.5" style="stop-color:rgb(var(--c-purple-500))" />
        <stop offset="1" style="stop-color:rgb(var(--c-indigo-500))" />
      </linearGradient>
    </defs>
    <path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8" /><path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1" /><path d="M2 21h20" /><path d="M7 8v3" /><path d="M12 8v3" /><path d="M17 8v3" /><path d="M7 4h.01" /><path d="M12 4h.01" /><path d="M17 4h.01" />
  </svg>
  <span class="text-xs font-medium uppercase tracking-widest text-slate-500 dark:text-white/50"><T es="Mi cumpleaños en" en="My birthday in" /></span>

  <div id="countdown-cumple" class="grid grid-cols-4 gap-1.5 w-full max-w-[16rem]" role="timer" aria-live="off">
    {unidades.map(u => (
      <div class="flex items-baseline justify-center gap-0.5 overflow-hidden">
        <span data-unit={u.id} class="block text-xl leading-7 font-bold tabular-nums gradient-text-animated">--</span>
        <span class="text-[11px] font-medium uppercase text-slate-400 dark:text-white/40">{u.label}</span>
      </div>
    ))}
  </div>
  <div class="w-full max-w-[16rem]">
    <div class="h-1 w-full overflow-hidden rounded-full bg-slate-200/70 dark:bg-white/10" aria-hidden="true">
      <div id="countdown-progress" class="h-full w-0 rounded-full bg-gradient-to-r from-fuchsia-500 via-purple-500 to-indigo-500 transition-[width] duration-1000"></div>
    </div>
    <p class="mt-1.5 text-right text-[11px] text-slate-400 dark:text-white/40"><T es="16 dic" en="Dec 16" /></p>
  </div>
  <p id="countdown-hoy" class="hidden text-2xl font-bold gradient-text-animated"><T es="¡Es hoy! 🥳" en="It's today! 🥳" /></p>
</article>

<style>
  .tick {
    animation: tick 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes tick {
    from { transform: translateY(-60%); opacity: 0; }
    to   { transform: translateY(0); opacity: 1; }
  }

  .cake-icon {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
  }
  .group:hover .cake-icon {
    transform: translateY(-3px) rotate(-6deg) scale(1.1);
    filter: drop-shadow(0 6px 12px rgb(var(--c-fuchsia-500) / 0.45));
  }
</style>

<script>
  function updateCountdown() {
    const el = document.getElementById('countdown-cumple');
    if (!el) return;

    const now = new Date();
    const currentYear = now.getFullYear();
    let target = new Date(currentYear, 11, 16);

    if (now.getMonth() === 11 && now.getDate() === 16) {
      el.classList.add('hidden');
      document.getElementById('countdown-hoy')?.classList.remove('hidden');
      return;
    }

    if (now.getTime() > target.getTime()) {
      target = new Date(currentYear + 1, 11, 16);
    }

    const diff = target.getTime() - now.getTime();
    const values: Record<string, string> = {
      d: String(Math.floor(diff / (1000 * 60 * 60 * 24))),
      h: String(Math.floor((diff / (1000 * 60 * 60)) % 24)).padStart(2, '0'),
      m: String(Math.floor((diff / 1000 / 60) % 60)).padStart(2, '0'),
      s: String(Math.floor((diff / 1000) % 60)).padStart(2, '0'),
    };
    el.querySelectorAll<HTMLElement>('[data-unit]').forEach(span => {
      const v = values[span.dataset.unit!];
      if (span.textContent === v) return;
      span.textContent = v;
      // Restart the slide-in animation on every change
      span.classList.remove('tick');
      void span.offsetWidth;
      span.classList.add('tick');
    });

    // Progress through the year since the last birthday
    const last = new Date(target.getFullYear() - 1, 11, 16);
    const pct = ((now.getTime() - last.getTime()) / (target.getTime() - last.getTime())) * 100;
    const bar = document.getElementById('countdown-progress');
    if (bar) bar.style.width = `${pct.toFixed(2)}%`;
  }

  let timer: ReturnType<typeof setInterval> | undefined;
  document.addEventListener('astro:page-load', () => {
    clearInterval(timer);
    if (!document.getElementById('countdown-cumple')) return;
    updateCountdown();
    timer = setInterval(updateCountdown, 1000);
  });
</script>
