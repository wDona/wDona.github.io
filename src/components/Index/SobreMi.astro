---
import BirthdayBadge from './SobreMi/BirthdayBadge.astro';
---

<section class="xl:w-[1200px] sm:w-[90%] w-[98%] py-16 flex flex-col gap-8 z-10 mx-auto" id="sobre-mi">
      <h2 class="text-4xl md:text-5xl zilla-slab-regular mb-2 text-center tracking-tight reveal text-slate-800 dark:text-white">Sobre Mí</h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 w-full">

    <article class="col-span-1 md:col-span-2 bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-3xl p-7 shadow-sm dark:shadow-none hover:bg-slate-50 dark:hover:bg-white/10 transition-colors duration-300 relative reveal" data-reveal-delay="100">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-2 sm:gap-0">
        <h3 class="text-2xl zilla-slab-regular text-slate-800 dark:text-white">¿Quién soy?</h3>
      </div>
      <p class="text-lg text-slate-600 dark:text-white/90 font-light leading-relaxed">
        Tengo <strong id="dynamic-age" class="dark:font-bold">19</strong><strong class="dark:font-bold"> años</strong> y una meta clara: <strong class="dark:font-bold">hacer feliz</strong> a la gente creando <strong class="dark:font-bold">soluciones de software</strong>. La informática para mí no es la simple rutina de <em>"hacer mis horas e irme"</em>, es mi <strong class="dark:font-bold">estilo de vida</strong>.
      </p>
    </article>

    <div class="reveal" data-reveal-delay="200"><BirthdayBadge /></div>

    <article class="col-span-1 border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 shadow-sm dark:shadow-none rounded-3xl p-7 hover:bg-slate-50 dark:hover:bg-white/10 transition-colors duration-300 flex flex-col justify-center reveal" data-reveal-delay="300">
      <h3 class="text-xl zilla-slab-regular mb-3 text-slate-800 dark:text-white">Mentalidad</h3>
      <p class="text-slate-600 dark:text-white/80 font-light text-md leading-relaxed">
        Me defino como una <strong class="dark:font-bold">esponja de información</strong>. Adoro aprender por mi cuenta sobre <strong class="dark:font-bold">tecnología, psicología y ajedrez</strong>.
      </p>
    </article>

    <!-- Stack -->
    <article class="col-span-1 md:col-span-2 bg-white dark:bg-white/5 shadow-sm dark:shadow-none border border-slate-200 dark:border-white/10 rounded-3xl p-7 hover:bg-slate-50 dark:hover:bg-white/10 transition-colors duration-300 flex flex-col justify-center reveal" data-reveal-delay="400">
      <h3 class="text-xl zilla-slab-regular mb-4 text-slate-800 dark:text-white">Mi Stack</h3>
      <a href="https://skillicons.dev" target="_blank" rel="noreferrer" class="w-full flex">
          <img src="https://skillicons.dev/icons?i=kotlin,ktor,java,mysql,git,docker,html,css" alt="Mis Skills" class="w-full max-w-[500px]" />
      </a>
      <p class="text-[13px] text-slate-500 dark:text-white/40 mt-4 font-light italic">
        * Principalmente backend. Abierto a nuevos lenguajes (Rust como preferencia para bajo nivel).
      </p>
    </article>

  </div>
</section>

<script>
  function updateAge() {
    const birthDate = new Date('2006-12-16');
    const today = new Date();
    
    let age = today.getFullYear() - birthDate.getFullYear();
    const m = today.getMonth() - birthDate.getMonth();
    
    if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
        age--;
    }
    
    const ageElement = document.getElementById('dynamic-age');
    if (ageElement) {
        ageElement.innerText = age.toString();
    }
  }

  updateAge();
</script>
