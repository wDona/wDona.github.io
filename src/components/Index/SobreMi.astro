---

<section class="relative xl:w-[1200px] sm:w-[90%] w-[98%] py-16 flex flex-col gap-8 z-10 mx-auto" id="sobre-mi" aria-labelledby="sobre-mi-titulo">
  <SectionBlobs variant="blue" />
  <h2 id="sobre-mi-titulo" class="section-title reveal">Sobre Mí</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 w-full">

    <!-- ¿Quién soy? (big tile) -->
    <article class="card md:col-span-2 lg:row-span-2 p-7 sm:p-8 flex flex-col items-center justify-center gap-4 text-center reveal" data-reveal-delay="100">
      <h3 class="text-2xl sm:text-3xl zilla-slab-regular text-slate-800 dark:text-white">¿Quién soy?</h3>
      <p class="text-lg sm:text-xl text-slate-600 dark:text-white/90 font-light leading-relaxed">
        Tengo <strong id="dynamic-age" class="dark:font-bold">19</strong><strong class="dark:font-bold"> años</strong> y una meta clara: <strong class="dark:font-bold">hacer feliz</strong> a la gente creando <strong class="dark:font-bold">soluciones de software</strong>. La informática para mí no es la simple rutina de <em>"hacer mis horas e irme"</em>, es mi <strong class="dark:font-bold">estilo de vida</strong>.
      </p>
    </article>

    <!-- Cifras -->
    <article class="card md:col-span-2 px-6 py-6 flex items-center justify-evenly gap-6 reveal" data-reveal-delay="200">
      <div class="flex flex-col items-center text-center gap-1">
        <span class="text-4xl sm:text-5xl font-bold tabular-nums gradient-text-animated" data-count={numProyectos}>{numProyectos}</span>
        <span class="text-sm text-slate-500 dark:text-white/50">Proyectos</span>
      </div>
      {numRepos > 0 && (
        <div class="flex flex-col items-center text-center gap-1">
          <span class="text-4xl sm:text-5xl font-bold tabular-nums gradient-text-animated" data-count={numRepos}>{numRepos}</span>
          <span class="text-sm text-slate-500 dark:text-white/50">Repos en GitHub</span>
        </div>
      )}
      <div class="flex flex-col items-center text-center gap-1">
        <span class="text-4xl sm:text-5xl font-bold tabular-nums gradient-text-animated">2021</span>
        <span class="text-sm text-slate-500 dark:text-white/50">Programando desde</span>
      </div>
    </article>

    <div class="reveal" data-reveal-delay="300"><BirthdayBadge /></div>

    <!-- Mentalidad -->
    <article class="card p-7 flex flex-col items-center justify-center text-center reveal" data-reveal-delay="400">
      <h3 class="text-xl zilla-slab-regular mb-2 text-slate-800 dark:text-white">Curiosidad</h3>
      <p class="text-slate-600 dark:text-white/80 font-light text-base mb-5">
        Aprendo por mi cuenta sobre:
      </p>
      <svg width="0" height="0" class="absolute" aria-hidden="true">
        <defs>
          <linearGradient id="interes-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="24" y2="24">
            <stop offset="0" style="stop-color:rgb(var(--c-fuchsia-500))" />
            <stop offset="0.5" style="stop-color:rgb(var(--c-purple-500))" />
            <stop offset="1" style="stop-color:rgb(var(--c-indigo-500))" />
          </linearGradient>
        </defs>
      </svg>
      <ul class="grid grid-cols-3 gap-2 w-full">
        {intereses.map(it => (
          <li class="group/int flex flex-col items-center gap-2 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="interes-icon block h-9 w-9" fill="none" stroke="url(#interes-grad)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={it.svg} />
            <span class="text-sm text-slate-600 dark:text-white/70">{it.label}</span>
          </li>
        ))}
      </ul>
      <p class="mt-4 flex items-baseline justify-center gap-[3px] text-sm text-slate-400 dark:text-white/40">
        y más<span class="sr-only">...</span>
        <span class="more-dot" aria-hidden="true"></span>
        <span class="more-dot" aria-hidden="true" style="animation-delay:0.2s"></span>
        <span class="more-dot" aria-hidden="true" style="animation-delay:0.4s"></span>
      </p>
    </article>


    <!-- Mi setup -->
    <article class="card group md:col-span-2 p-6 sm:p-7 flex flex-col items-center justify-center gap-6 text-center reveal" data-reveal-delay="100">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="arch-watermark pointer-events-none absolute -bottom-10 -right-8 h-52 w-52 text-slate-900 dark:text-[#1793D1] opacity-[0.05] dark:opacity-[0.09]" fill="currentColor" aria-hidden="true"><path d={setup[0].d} /></svg>
      <h3 class="relative text-2xl leading-none zilla-slab-regular text-slate-800 dark:text-white">"I use arch btw"</h3>
      <ul class="relative flex flex-wrap items-center justify-center gap-5">
        {setup.map((t, i) => (
          <li title={t.label}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" role="img" aria-label={t.label}
              class="setup-icon block h-11 w-11" style={`--brand:${t.color};--d:${i * 50}ms`} fill="currentColor"><path d={t.d} /></svg>
          </li>
        ))}
      </ul>
    </article>

    <!-- Stack -->
    <article class="card md:col-span-2 p-6 sm:p-7 flex flex-col items-center justify-center text-center reveal" data-reveal-delay="200">
      <h3 class="text-2xl leading-none zilla-slab-regular mb-4 text-slate-800 dark:text-white">Mi Stack</h3>
      <ul class="stack-grid grid grid-cols-5 gap-x-3 gap-y-2 w-full max-w-md" aria-label="Mis Skills">
        {stack.map((t, i) => (
          <li class="stack-tile group/tile flex flex-col items-center gap-1" style={`--c:${t.color};--i:${i}`}>
            <img src={`/img/stack/${t.id}-light.svg`} alt="" class="stack-icon block dark:hidden h-12 w-12 sm:h-[52px] sm:w-[52px]" loading="lazy" aria-hidden="true" />
            <img src={`/img/stack/${t.id}.svg`} alt="" class="stack-icon hidden dark:block h-12 w-12 sm:h-[52px] sm:w-[52px]" loading="lazy" aria-hidden="true" />
            <span class="text-xs sm:text-sm leading-none text-slate-600 dark:text-white/60 transition-colors duration-300 group-hover/tile:text-slate-900 dark:group-hover/tile:text-white">{t.label}</span>
          </li>
        ))}
      </ul>
    </article>

  </div>
</section>

<script>
  function updateAge() {
    const birthDate = new Date('2006-12-16');
    const today = new Date();
    
    let age = today.getFullYear() - birthDate.getFullYear();
    const m = today.getMonth() - birthDate.getMonth();
    
    if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
        age--;
    }
    
    const ageElement = document.getElementById('dynamic-age');
    if (ageElement) {
        ageElement.innerText = age.toString();
    }
  }

  document.addEventListener('astro:page-load', updateAge);

  // Count-up for the figures tile, triggered when it scrolls into view
  const countIO = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      const target = Number(el.dataset.count);
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / 1200, 1);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
      countIO.unobserve(el);
    });
  }, { threshold: 0.6 });
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach(el => countIO.observe(el));
  });
</script>


<style>
  /* Setup icons pop one after another on card hover */
  /* Brand colours: always in dark mode; in light (monochrome) only on hover */
  .setup-icon { color: var(--brand); }
  :global(html[data-palette="mono"]:not(.dark)) .setup-icon { color: #27272a; }
  :global(html.dark[data-palette="mono"]) .setup-icon { color: #e4e4e7; }
  :global(html[data-palette="mono"]) .group:hover .setup-icon { color: var(--brand); }
  
  .setup-icon {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) var(--d), filter 0.5s ease var(--d), color 0.4s ease var(--d);
  }
  /* Stack tiles: staggered pop-in on reveal, brand-colour glow on hover */
  .stack-icon {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
  }
  .stack-tile:hover .stack-icon {
    transform: translateY(-4px) scale(1.1);
    filter: drop-shadow(0 8px 16px var(--c));
  }
  :global(.js-ready) .stack-grid .stack-tile {
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(var(--i) * 60ms + 200ms);
  }
  :global(.js-ready) .revealed .stack-grid .stack-tile {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .stack-grid .stack-tile { opacity: 1 !important; transform: none !important; }
  }

  /* Interest icons: quick lift + glow on hover, same feel as the stack */
  .interes-icon {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
  }
  .group\/int:hover .interes-icon {
    transform: translateY(-3px) scale(1.1);
    filter: drop-shadow(0 6px 12px rgb(var(--c-fuchsia-500) / 0.45));
  }

  /* "y más" ellipsis: dots on the text baseline, soft typing pulse */
  .more-dot {
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    background: currentColor;
    animation: moreDot 1.4s ease-in-out infinite;
  }
  .more-dot:first-of-type { margin-left: 1px; }
  @keyframes moreDot {
    0%, 80%, 100% { opacity: 0.35; }
    40% { opacity: 1; }
  }

  .arch-watermark {
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .group:hover .arch-watermark {
