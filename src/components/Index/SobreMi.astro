---

<section class="sec" id="sobre-mi" aria-labelledby="sobre-mi-titulo">
  <h2 id="sobre-mi-titulo"><T es="Sobre mí" en="About" /></h2>
  <div>
    <dl class="facts">
      <dt class="meta"><T es="Edad" en="Age" /></dt>
      <dd><span class="dynamic-age">19</span></dd>

      <dt class="meta"><T es="Programando desde" en="Coding since" /></dt>
      <dd>2021</dd>

      <dt class="meta"><T es="Intereses" en="Interests" /></dt>
      <dd><T es="Psicología, ajedrez" en="Psychology, chess" /></dd>

      <dt class="meta"><T es="Conocimientos" en="Skills" /></dt>
      <dd>
        <ul class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Mis conocimientos" data-en-aria-label="My skills">
          {stack.map(t => (
            <li class="inline-flex items-center gap-1.5 text-[0.95rem]">
              <img src={`/img/stack/${t.id}-light.svg`} alt="" class="dark:hidden h-4 w-4" aria-hidden="true" />
              <img src={`/img/stack/${t.id}.svg`} alt="" class="hidden dark:block h-4 w-4" aria-hidden="true" />
              {t.label}
            </li>
          ))}
        </ul>
      </dd>

      <dt class="meta"><T es="Mi equipo" en="My setup" /></dt>
      <dd>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {setup.map(t => (
            <li class="inline-flex items-center gap-1.5 text-[0.95rem]">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d={t.d} /></svg>
              {t.label}
            </li>
          ))}
        </ul>
        <p class="meta mt-2">(I use arch, btw)</p>
      </dd>

      <dt class="meta"><T es="Cumpleaños" en="Birthday" /></dt>
      <dd><BirthdayBadge /></dd>
    </dl>
  </div>
</section>

<style>
  .facts { display: grid; }
  .facts > * { padding: 1rem 0; border-top: 1px solid rgb(var(--rule)); }
  .facts dt { padding-bottom: 0; }
  @media (min-width: 640px) {
    .facts { grid-template-columns: 8rem 1fr; column-gap: 1.5rem; }
    .facts dt { padding-bottom: 1rem; padding-top: 1.2rem; }
  }
  @media (max-width: 639px) {
    .facts dd { border-top: 0; padding-top: 0.5rem; }
  }
</style>

<script>
  function updateAge() {
    const birth = new Date('2006-12-16');
    const today = new Date();
    let age = today.getFullYear() - birth.getFullYear();
    const m = today.getMonth() - birth.getMonth();
    if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
    document.querySelectorAll<HTMLElement>('.dynamic-age').forEach(el => el.innerText = age.toString());
  }
  document.addEventListener('astro:page-load', updateAge);
</script>
