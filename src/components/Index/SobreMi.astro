---
import BirthdayBadge from './BirthdayBadge.astro';
---

<section class="xl:w-[1200px] sm:w-[90%] w-[98%] py-16 flex flex-col gap-8 z-10 mx-auto" id="sobre-mi">
      <h2 class="text-3xl zilla-slab-regular mb-2 text-center text-fuchsia-400">Sobre Mí</h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 w-full">
    
    <article class="col-span-1 md:col-span-2 bg-white/5 border border-white/10 rounded-3xl p-7 hover:bg-white/10 transition-colors duration-300 relative">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-2 sm:gap-0">
        <h3 class="text-2xl zilla-slab-regular text-fuchsia-400">¿Quién soy?</h3>
      </div>
      <p class="text-lg opacity-90 font-light leading-relaxed">
        Tengo <strong id="dynamic-age">19</strong><strong> años</strong> y una meta clara: <strong>hacer feliz</strong> a la gente creando <strong>soluciones de software</strong>. La informática para mí no es la simple rutina de <em>"hacer mis horas e irme"</em>, es mi <strong>estilo de vida</strong>.
      </p>
    </article>

    <BirthdayBadge />

    <article class="col-span-1 border border-white/10 bg-white/5 rounded-3xl p-7 hover:bg-white/10 transition-colors duration-300 flex flex-col justify-center">
      <h3 class="text-xl zilla-slab-regular mb-3 text-fuchsia-400">Mentalidad</h3>
      <p class="opacity-80 font-light text-md leading-relaxed">
        Me defino como una <strong>esponja de información</strong>. Adoro aprender por mi cuenta sobre <strong>tecnología, psicología y ajedrez</strong>.
      </p>
    </article>

    <!-- Stack -->
    <article class="col-span-1 md:col-span-2 bg-white/5 border border-white/10 rounded-3xl p-7 hover:bg-white/10 transition-colors duration-300 flex flex-col justify-center">
      <h3 class="text-xl zilla-slab-regular mb-4 text-fuchsia-400">Mi Stack</h3>
      <a href="https://skillicons.dev" target="_blank" rel="noreferrer" class="w-full flex">
          <img src="https://skillicons.dev/icons?i=kotlin,ktor,java,mysql,git,docker,html,css" alt="Mis Skills" class="w-full max-w-[500px]" />
      </a>
      <p class="text-[13px] opacity-40 mt-4 font-light italic">
        * Principalmente backend. Abierto a nuevos lenguajes (Rust como preferencia para bajo nivel).
      </p>
    </article>

  </div>
</section>

<script>
  function updateAge() {
    const birthDate = new Date('2006-12-16');
    const today = new Date();
    
    let age = today.getFullYear() - birthDate.getFullYear();
    const m = today.getMonth() - birthDate.getMonth();
    
    if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
        age--;
    }
    
    const ageElement = document.getElementById('dynamic-age');
    if (ageElement) {
        ageElement.innerText = age.toString();
    }
  }

  updateAge();
</script>
