---
import T from "../Common/T.astro";
import ExperienciaItem from "./Experiencia/ExperienciaItem.astro";

const practicas = [
  { area: "Web y WordPress", areaEn: "Web and WordPress", empresa: "Valentina System", meses: 3 },
  { area: "Android (Java)", areaEn: "Android (Java)", empresa: "WUL 4", meses: 5 },
];
---

<section class="sec" id="experiencia" aria-labelledby="experiencia-titulo">
  <h2 id="experiencia-titulo"><T es="Experiencia" en="Experience" /></h2>
  <div>
    <ExperienciaItem title="Investigador de IA" titleEn="AI Researcher" org="Softtek" timeRange="Actual" timeRangeEn="Current" />

    <ExperienciaItem
      title="Formación oficial"
      titleEn="Formal education"
      tags={["Grado Medio", "Grado Superior"]}
      tagsEn={["Intermediate Vocational Degree", "Higher Vocational Degree"]}
    >
      <table class="w-full max-w-xl text-[0.95rem]">
        <tbody>
          {practicas.map(p => (
            <tr class="rule-t">
              <td class="py-2 pr-4"><T es={p.area} en={p.areaEn} /></td>
              <td class="py-2 pr-4 muted">{p.empresa}</td>
              <td class="py-2 meta text-right whitespace-nowrap">
                <T es={`${p.meses} meses, 3 días/sem.`} en={`${p.meses} months, 3 days/wk`} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </ExperienciaItem>

    <ExperienciaItem title="Autodidacta" titleEn="Self-taught" timeRange="+1,5 años" timeRangeEn="1.5+ years" tags={["Proyectos propios", "Automatización", "Despliegues"]} tagsEn={["Personal projects", "Automation", "Deployments"]} />
  </div>
</section>
