---
import ExperienciaItem from "./Experiencia/ExperienciaItem.astro";
import EmpresaCard from "./Experiencia/EmpresaCard.astro";
import Tag from "./Experiencia/Tag.astro";
import SectionBlobs from "../Common/Decoracion/SectionBlobs.astro";
---

<section class="relative w-full max-w-5xl px-4 sm:px-6 py-16 mx-auto z-10" id="experiencia" aria-labelledby="experiencia-titulo">
  <SectionBlobs variant="fuchsia" />
  <h2 id="experiencia-titulo" class="text-4xl md:text-5xl zilla-slab-regular text-center mb-12 tracking-tight reveal text-slate-800 dark:text-white">Experiencia</h2>

  <div class="flex flex-col relative">

    <!-- Softtek — Actual -->
    <ExperienciaItem 
      title="Investigador de IA" 
      timeRange="Actual"
      isLast={false}
      accent="active"
    >
      <Tag color="fuchsia">Softtek</Tag>
    </ExperienciaItem>

    <!-- Formación Oficial -->
    <ExperienciaItem 
      title="Formación Oficial" 
      tags={["Grado Medio", "Grado Superior"]}
      accent="past"
    >
      <div class="flex flex-col gap-4">
        <p class="text-slate-600 dark:text-white/60 font-light leading-relaxed text-lg">
          Formaciones en empresa durante el Grado Superior — 3 proyectos en producción + proyectos internos:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <EmpresaCard title="Web & Wordpress">
            <Tag color="indigo">Valentina System</Tag>
            <Tag color="slate">3 meses</Tag>
            <Tag color="slate">3 días/semana</Tag>
          </EmpresaCard>

          <EmpresaCard title="Android (Java)">
            <Tag color="emerald">WUL 4</Tag>
            <Tag color="slate">5 meses</Tag>
            <Tag color="slate">3 días/semana</Tag>
          </EmpresaCard>
        </div>
      </div>
    </ExperienciaItem>

    <!-- Autodidacta -->
    <ExperienciaItem 
      title="Autodidacta" 
      timeRange="+1.5 años"
      isLast={true}
      accent="past"
    >
      <p class="text-slate-600 dark:text-white/60 font-light leading-relaxed text-lg">
        Proyectos personales, automatización y gestión de servidores.
      </p>
    </ExperienciaItem>

  </div>
</section>
