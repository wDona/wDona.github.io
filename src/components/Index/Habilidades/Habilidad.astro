---
interface Props {
    img: string;
    title?: string;
}
const img = Astro.props.img;
const title = Astro.props.title;
---

<div class=" h-16 p-1 sm:w-20 sm:h-20 sm:p-2 mb-4 flex flex-col items-center justify-center mx-auto rounded-lg hover:scale-105 transition-all duration-200">
    <div class = "w-full h-full flex items-center justify-center">
        <img src={img} alt={title} class="w-full h-full object-contain" loading="lazy"/>
    </div>
    {title && <p class="text-center text-sm mt-2">{title}</p>}
</div>
