---
import { getCollection } from 'astro:content';
import T from '../Common/T.astro';
import ProyectoCard from "./Proyectos/ProyectoCard.astro";
import ProjectImage from './Proyectos/ProjectImage.astro';
import Plataformas from './Proyectos/Plataformas.astro';
import TechList from './Proyectos/TechList.astro';

const todos = await getCollection('proyectos');
const destacados = todos.filter(p => p.data.highlight);
const proyectos = todos.filter(p => !p.data.highlight);
const en = new Map((await getCollection('proyectosEn')).map(e => [e.id, e.data]));

const allTechs = [...new Set(proyectos.flatMap(p => p.data.tecnologias?.map(t => t.name) ?? []))];
---

<section class="sec" id="destacados" aria-labelledby="proyectos-titulo">
  <h2 id="proyectos-titulo"><T es="Proyectos" en="Projects" /></h2>
  <div>
    <div class="flex flex-col gap-10">
      {destacados.map(({ id, data }) => {
        const t = en.get(id);
        return (
          <article class="featured">
            <a href={`/proyectos/${id}`} tabindex="-1" aria-hidden="true">
              <ProjectImage img={data.img} cover={data.cover} alt="" class="aspect-[16/10]" />
            </a>
            <div>
              <h3 class="text-2xl sm:text-[1.7rem]"><a href={`/proyectos/${id}`} class="plain"><T es={data.title} en={t?.title} /></a></h3>
              {data.summary && <p class="mt-2"><T es={data.summary} en={t?.summary} /></p>}
              <TechList tecnologias={data.tecnologias} class="mt-3" />
              <div class="mt-2"><Plataformas plataformas={data.plataformas} /></div>
            </div>
          </article>
        );
      })}
    </div>

    <div id="proyectos" class="mt-14">
      <h3 class="text-xl"><T es="Otros proyectos" en="Other projects" /></h3>

      <div id="tech-filters" class="mt-3 flex flex-wrap gap-x-4 gap-y-1" role="group" aria-label="Filtrar por tecnología" data-en-aria-label="Filter by technology">
        <button type="button" data-filter="all" class="filter-btn toggle" aria-pressed="true"><T es="todos" en="all" /></button>
        {allTechs.map(name => (
          <button type="button" data-filter={name} class="filter-btn toggle" aria-pressed="false">{name}</button>
        ))}
      </div>

      <ul class="mt-5">
        {proyectos.map(p => (
          <li class="proyecto-item rule-t py-5" data-techs={JSON.stringify(p.data.tecnologias?.map(t => t.name) ?? [])}>
            <ProyectoCard
              id={p.id}
              title={p.data.title}
              titleEn={en.get(p.id)?.title}
              img={p.data.img}
              cover={p.data.cover}
              link={p.data.link}
              linkdescarga={p.data.linkdescarga}
              tecnologias={p.data.tecnologias}
              summary={p.data.summary}
              summaryEn={en.get(p.id)?.summary}
              plataformas={p.data.plataformas}
            />
          </li>
        ))}
      </ul>

      <div id="pagination-controls" class="rule-t pt-4 flex items-center gap-5 hidden">
        <button type="button" id="prev-page" class="toggle"><T es="← anterior" en="← previous" /></button>
        <span id="page-info" class="meta"></span>
        <button type="button" id="next-page" class="toggle"><T es="siguiente →" en="next →" /></button>
      </div>
    </div>
  </div>
</section>

<style>
  .featured {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .featured { grid-template-columns: 5fr 4fr; gap: 1.75rem; align-items: start; }
  }
</style>

<script>
  import { linkLatestReleases } from '../../lib/releases';

  document.addEventListener('astro:page-load', () => {
    linkLatestReleases();
    if (!document.getElementById('tech-filters')) return;
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = [...document.querySelectorAll<HTMLElement>('.proyecto-item')];
    const controls = document.getElementById('pagination-controls')!;
    const prev = document.getElementById('prev-page') as HTMLButtonElement;
    const next = document.getElementById('next-page') as HTMLButtonElement;
    const pageInfo = document.getElementById('page-info')!;

    const perPage = 6;
    let page = 1;
    let filter = 'all';

    const visible = () => cards.filter(c => filter === 'all' || (JSON.parse(c.dataset.techs || '[]') as string[]).includes(filter));

    function render() {
      const list = visible();
      const pages = Math.ceil(list.length / perPage);
      cards.forEach(c => (c.hidden = true));
      list.slice((page - 1) * perPage, page * perPage).forEach(c => (c.hidden = false));
      controls.classList.toggle('hidden', pages <= 1);
      pageInfo.innerHTML = `<span data-l="es">página ${page} de ${pages}</span><span data-l="en">page ${page} of ${pages}</span>`;
      prev.disabled = page === 1;
      next.disabled = page === pages;
    }

    const go = (delta: number) => {
      page += delta;
      render();
      document.getElementById('proyectos')?.scrollIntoView();
    };

    filterBtns.forEach(btn => btn.addEventListener('click', () => {
      filter = btn.dataset.filter!;
      page = 1;
      filterBtns.forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
      render();
    }));
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));

    render();
  });
</script>
