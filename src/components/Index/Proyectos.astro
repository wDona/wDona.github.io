---
import { getCollection } from 'astro:content';
import T from '../Common/T.astro';
import ProyectoCard from "./Proyectos/ProyectoCard.astro";
import SectionBlobs from "../Common/Decoracion/SectionBlobs.astro";

const proyectos = (await getCollection('proyectos'))
  .filter(p => !p.data.highlight);
const en = new Map((await getCollection('proyectosEn')).map(e => [e.id, e.data]));

const allTechs = [...new Map(
  proyectos.flatMap(p => p.data.tecnologias ?? []).map(t => [t.name, t])
).values()];
---

<section id="proyectos" class="relative xl:w-[1200px] sm:w-[90%] w-[98%] py-16 mx-auto" aria-labelledby="proyectos-titulo">
  <SectionBlobs variant="mixed" />
  <h2 id="proyectos-titulo" class="section-title reveal"><T es="Más proyectos" en="More projects" /></h2>

  <!-- Filtros -->
  <div id="tech-filters" class="flex flex-wrap gap-2 justify-center mb-10 relative z-10 reveal" data-reveal-delay="150">
    <button
      data-filter="all"
      class="filter-btn chip active"
      aria-pressed="true"
    >
      <T es="Todos" en="All" />
    </button>
    {allTechs.map(tec => (
      <button
        data-filter={tec.name}
        class="filter-btn chip"
        aria-pressed="false"
      >
        <img src={"/" + tec.img} alt={tec.name} class="w-4 h-4 object-contain" loading="lazy" />
        {tec.name}
      </button>
    ))}
  </div>

  <!-- Grid de proyectos -->
  <div class="flex flex-wrap justify-center gap-8 zilla-slab-regular relative">
    {proyectos.map((proyecto, i) => (
      <div
        class="proyecto-item reveal w-full md:w-[calc(50%-16px)] lg:w-[calc(33.333%-22px)]"
        data-techs={JSON.stringify(proyecto.data.tecnologias?.map(t => t.name) ?? [])}
        data-reveal-delay={200 + i * 150}
      >
        <ProyectoCard
          id={proyecto.id}
          title={proyecto.data.title}
          titleEn={en.get(proyecto.id)?.title}
          img={proyecto.data.img}
          cover={proyecto.data.cover}
          link={proyecto.data.link}
          linkdescarga={proyecto.data.linkdescarga}
          tecnologias={proyecto.data.tecnologias}
          summary={proyecto.data.summary}
          plataformas={proyecto.data.plataformas}
        />
      </div>
    ))}
  </div>

  <div id="pagination-controls" class="flex justify-center items-center gap-4 mt-12 hidden relative z-10 zilla-slab-regular">
    <button id="prev-page" class="chip disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:translate-y-0">
      <T es="Anterior" en="Previous" />
    </button>
    <span id="page-info" class="text-slate-800 dark:text-gray-300 font-medium">
    </span>
    <button id="next-page" class="chip disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:translate-y-0">
      <T es="Siguiente" en="Next" />
    </button>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('tech-filters')) return;
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.proyecto-item');
    const paginationControls = document.getElementById('pagination-controls');
    const prevPageBtn = document.getElementById('prev-page') as HTMLButtonElement;
    const nextPageBtn = document.getElementById('next-page') as HTMLButtonElement;
    const pageInfo = document.getElementById('page-info');

    let currentPage = 1;
    const itemsPerPage = 6;
    let currentFilter = 'all';

    function updatePagination(animate = true) {
      const visibleCards = Array.from(cards).filter(card => {
        if (currentFilter === 'all') return true;
        const techs: string[] = JSON.parse(card.dataset.techs || '[]');
        return techs.includes(currentFilter);
      });

      const totalPages = Math.ceil(visibleCards.length / itemsPerPage);

      cards.forEach(card => card.style.display = 'none');

      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;

      visibleCards.slice(startIndex, endIndex).forEach(card => {
        card.style.display = '';
      });

      // On load the scroll reveal handles the entrance; on filter/page change replay it staggered
      if (animate) {
        visibleCards.slice(startIndex, endIndex).forEach((card, index) => {
          card.classList.remove('revealed');
          void card.offsetWidth;
          setTimeout(() => card.classList.add('revealed'), 50 + index * 100);
        });
      }

      if (totalPages > 1) {
        paginationControls?.classList.remove('hidden');
        if (pageInfo) pageInfo.innerHTML = `<span data-l="es">Página ${currentPage} de ${totalPages}</span><span data-l="en">Page ${currentPage} of ${totalPages}</span>`;
        if (prevPageBtn) prevPageBtn.disabled = currentPage === 1;
        if (nextPageBtn) nextPageBtn.disabled = currentPage === totalPages;
      } else {
        paginationControls?.classList.add('hidden');
      }
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = btn.dataset.filter!;
        currentPage = 1; 

        filterBtns.forEach(b => {
          b.classList.toggle('active', b === btn);
          b.setAttribute('aria-pressed', String(b === btn));
        });

        updatePagination();
      });
    });

    prevPageBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        updatePagination();
        document.getElementById('proyectos')?.scrollIntoView({ behavior: 'smooth' });
      }
    });

    nextPageBtn?.addEventListener('click', () => {
      const visibleCards = Array.from(cards).filter(card => {
        if (currentFilter === 'all') return true;
        const techs: string[] = JSON.parse(card.dataset.techs || '[]');
        return techs.includes(currentFilter);
      });
      const totalPages = Math.ceil(visibleCards.length / itemsPerPage);

      if (currentPage < totalPages) {
        currentPage++;
        updatePagination();
        document.getElementById('proyectos')?.scrollIntoView({ behavior: 'smooth' });
      }
    });

    // Init
    updatePagination(false);
});
</script>
