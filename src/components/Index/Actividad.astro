---
import { getCollection, getEntry } from "astro:content";
import T from "../Common/T.astro";
import { getRepos } from "../../lib/github";

const repos = await getRepos();

const recientes = [...repos]
  .sort((a, b) => b.pushed_at.localeCompare(a.pushed_at))
  .slice(0, 4);

// GitHub linguist colors
const langColors: Record<string, string> = {
  Rust: "#dea584", Kotlin: "#A97BFF", Java: "#b07219", TypeScript: "#3178c6",
  JavaScript: "#f1e05a", Svelte: "#ff3e00", Astro: "#ff5a03", Shell: "#89e051",
  HTML: "#e34c26", CSS: "#663399",
};
const counts = new Map<string, number>();
repos.forEach(r => r.language && counts.set(r.language, (counts.get(r.language) ?? 0) + 1));
const total = [...counts.values()].reduce((a, b) => a + b, 0);
const lenguajes = [...counts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, n]) => ({ name, pct: Math.round((n / total) * 100), color: langColors[name] ?? "#94a3b8" }));

const fecha = (iso: string, locale = "es-ES") =>
  new Date(iso).toLocaleDateString(locale, { day: "numeric", month: "short", year: "numeric" });

const blogs = await getCollection("blog");
const ultimoBlog = blogs.sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))[0];
const ultimoBlogEn = ultimoBlog && (await getEntry("blogEn", ultimoBlog.id))?.data;
---
<section class="sec" id="actividad" aria-labelledby="actividad-titulo">
  <h2 id="actividad-titulo"><T es="Actividad" en="Activity" /></h2>
  <div class="grid gap-10 lg:grid-cols-2">

    {recientes.length > 0 && (
      <div>
        <h3 class="text-lg">
          <a href="https://github.com/wDona" target="_blank" rel="noopener noreferrer" class="plain">
            <T es="Últimos cambios en GitHub" en="Latest pushes on GitHub" />
          </a>
        </h3>
        <ul class="mt-3">
          {recientes.map(r => (
            <li class="rule-t">
              <a href={r.html_url} target="_blank" rel="noopener noreferrer" class="plain flex items-baseline justify-between gap-3 py-2">
                <span class="flex items-baseline gap-2 min-w-0">
                  <span class="h-2 w-2 flex-shrink-0 self-center" style={`background:${langColors[r.language ?? ""] ?? "#94a3b8"}`} aria-hidden="true"></span>
                  <span class="truncate">{r.name}</span>
                </span>
                <span class="meta flex-shrink-0"><T es={fecha(r.pushed_at)} en={fecha(r.pushed_at, "en-US")} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {lenguajes.length > 0 && (
      <div>
        <h3 class="text-lg"><T es="Lenguajes por repositorio" en="Languages by repository" /></h3>
        <div class="mt-4 flex h-2 w-full" role="img" aria-label={lenguajes.map(l => `${l.name} ${l.pct}%`).join(", ")}>
          {lenguajes.map(l => <span class="h-full" style={`width:${l.pct}%;background:${l.color}`}></span>)}
        </div>
        <ul class="mt-4 grid grid-cols-2 gap-x-6">
          {lenguajes.map(l => (
            <li class="rule-t flex items-center gap-2 py-1.5 text-[0.95rem]">
              <span class="h-2 w-2 flex-shrink-0" style={`background:${l.color}`} aria-hidden="true"></span>
              {l.name}
              <span class="meta ml-auto tabular-nums">{l.pct}%</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {ultimoBlog && (
      <div class="lg:col-span-2 rule-t pt-6">
        <p class="meta"><T es="Última entrada del blog" en="Latest blog post" /></p>
        <h3 class="text-xl mt-1"><a href={`/blog/${ultimoBlog.id}`} class="plain"><T es={ultimoBlog.data.title} en={ultimoBlogEn?.title} /></a></h3>
      </div>
    )}
  </div>
</section>
