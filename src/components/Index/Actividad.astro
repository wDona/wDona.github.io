---
import { getCollection } from "astro:content";
import { getRepos } from "../../lib/github";
import SectionBlobs from "../Common/Decoracion/SectionBlobs.astro";

const repos = await getRepos();

const recientes = [...repos]
  .sort((a, b) => b.pushed_at.localeCompare(a.pushed_at))
  .slice(0, 4);

// GitHub linguist colors
const langColors: Record<string, string> = {
  Rust: "#dea584", Kotlin: "#A97BFF", Java: "#b07219", TypeScript: "#3178c6",
  JavaScript: "#f1e05a", Svelte: "#ff3e00", Astro: "#ff5a03", Shell: "#89e051",
  HTML: "#e34c26", CSS: "#663399",
};
const counts = new Map<string, number>();
repos.forEach(r => r.language && counts.set(r.language, (counts.get(r.language) ?? 0) + 1));
const total = [...counts.values()].reduce((a, b) => a + b, 0);
const lenguajes = [...counts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, n]) => ({ name, pct: Math.round((n / total) * 100), color: langColors[name] ?? "#94a3b8" }));

const fecha = (iso: string) =>
  new Date(iso).toLocaleDateString("es-ES", { day: "numeric", month: "short", year: "numeric" });

const blogs = await getCollection("blog");
const ultimoBlog = blogs.sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))[0];
---
<section class="relative xl:w-[1200px] sm:w-[90%] w-[98%] py-12 mx-auto" id="actividad" aria-labelledby="actividad-titulo">
  <SectionBlobs variant="purple" />
  <h2 id="actividad-titulo" class="section-title reveal">Actividad</h2>

  <div class="flex flex-wrap gap-4 w-full">

    {recientes.length > 0 && (
      <article class="card group reveal flex-[1_1_340px] p-6 flex flex-col gap-4 cursor-pointer" data-reveal-delay="100">
        <a href="https://github.com/wDona" target="_blank" rel="noopener noreferrer" class="absolute inset-0 z-0 rounded-[inherit]" aria-label="Perfil de GitHub (abre en nueva pestaña)"></a>
        <div class="flex items-center gap-4 pointer-events-none">
          <img src="/img/github.svg" alt="" class="w-12 h-12 brightness-0 dark:invert" aria-hidden="true" />
          <div class="flex flex-col">
            <span class="font-bold text-lg text-slate-800 dark:text-white group-hover:text-fuchsia-600 dark:group-hover:text-fuchsia-300 transition-colors duration-300">GitHub</span>
            <span class="text-sm text-slate-500 dark:text-white/50">Últimos repos</span>
          </div>
        </div>
        <ul class="relative z-10 flex flex-col gap-2 pointer-events-none">
          {recientes.map(r => (
            <li>
              <a href={r.html_url} target="_blank" rel="noopener noreferrer" class="group/repo pointer-events-auto flex items-center justify-between gap-3 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 px-3 py-2 hover:border-fuchsia-300 dark:hover:border-fuchsia-500/40 transition-colors duration-300">
                <span class="flex items-center gap-2 min-w-0">
                  <span class="h-2.5 w-2.5 flex-shrink-0 rounded-full" style={`background:${langColors[r.language ?? ""] ?? "#94a3b8"}`} aria-hidden="true"></span>
                  <span class="text-base truncate text-slate-700 dark:text-white/80 group-hover/repo:text-fuchsia-600 dark:group-hover/repo:text-fuchsia-300 transition-colors">{r.name}</span>
                </span>
                <span class="text-xs flex-shrink-0 text-slate-500 dark:text-white/40">{fecha(r.pushed_at)}</span>
              </a>
            </li>
          ))}
        </ul>
      </article>
    )}

    {lenguajes.length > 0 && (
      <a href="https://github.com/wDona" target="_blank" rel="noopener noreferrer" aria-label="Lenguajes en GitHub (abre en nueva pestaña)" class="card group reveal flex-[1_1_340px] p-6 flex flex-col gap-4" data-reveal-delay="200">
        <div class="flex flex-col">
          <span class="font-bold text-lg text-slate-800 dark:text-white group-hover:text-fuchsia-600 dark:group-hover:text-fuchsia-300 transition-colors duration-300">Lenguajes</span>
          <span class="text-sm text-slate-500 dark:text-white/50">Por repositorio en GitHub</span>
        </div>
        <div class="flex h-3 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-white/10" role="img" aria-label={lenguajes.map(l => `${l.name} ${l.pct}%`).join(", ")}>
          {lenguajes.map((l, i) => (
            <span class="lang-seg h-full" style={`width:${l.pct}%;background:${l.color};--d:${i * 80}ms`}></span>
          ))}
        </div>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2">
          {lenguajes.map(l => (
            <li class="flex items-center gap-2 text-sm text-slate-600 dark:text-white/70">
              <span class="h-2.5 w-2.5 rounded-full flex-shrink-0" style={`background:${l.color}`} aria-hidden="true"></span>
              {l.name}
              <span class="ml-auto tabular-nums text-slate-400 dark:text-white/40">{l.pct}%</span>
            </li>
          ))}
        </ul>
      </a>
    )}

    {ultimoBlog && (
      <a href={`/blog/${ultimoBlog.id}`} class="card group reveal flex-[1_1_340px] p-6 flex flex-col gap-3" data-reveal-delay="300">
        <span class="text-xs font-medium uppercase tracking-widest text-fuchsia-600 dark:text-fuchsia-400">Último post</span>
        <span class="text-2xl font-bold text-slate-800 dark:text-white group-hover:text-fuchsia-600 dark:group-hover:text-fuchsia-300 transition-colors duration-300">{ultimoBlog.data.title}</span>
        {ultimoBlog.data.description && (
          <p class="text-base leading-relaxed text-slate-500 dark:text-white/60 line-clamp-5">{ultimoBlog.data.description}</p>
        )}
        <span class="mt-auto inline-flex items-center gap-1.5 text-sm text-slate-500 dark:text-white/50 group-hover:text-fuchsia-600 dark:group-hover:text-fuchsia-300 transition-colors duration-300">
          Leer
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform duration-300" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    )}
  </div>
</section>

<style>
  /* Language bar segments grow in once the card is revealed */
  .lang-seg {
    transform-origin: left;
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) var(--d);
  }
  :global(.js-ready) .card:not(.revealed) .lang-seg {
    transform: scaleX(0);
  }
</style>
