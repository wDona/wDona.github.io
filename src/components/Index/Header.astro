---
import RoleBadge from "./Header/RoleBadge.astro";
import SectionBlobs from "../Common/Decoracion/SectionBlobs.astro";
---

<header class="min-h-screen w-full flex items-center justify-center relative overflow-x-clip" role="banner">
  <SectionBlobs variant="fuchsia" />
  
  <div class="z-10 flex flex-col items-start justify-center text-left px-4 sm:px-6 w-full max-w-5xl mx-auto gap-6 sm:gap-8 mt-16 sm:mt-0">
    
    <div class="flex flex-col items-start gap-3 max-w-4xl">
      <p class="text-2xl sm:text-3xl font-medium tracking-tight zilla-slab-regular header-name">
        <span class="gradient-text-animated font-bold">wDona</span>
      </p> 
      
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight zilla-slab-regular text-pretty text-slate-800 dark:text-white header-title leading-[1.1]">
        <span class="header-word" style="--i:0">Perfeccionista</span>
        <span class="header-word" style="--i:1">por</span>
        <span class="header-word" style="--i:2">vocación,</span>
        <br class="hidden sm:block" />
        <span class="header-word" style="--i:3">explorador</span>
        <span class="header-word" style="--i:4">por</span>
        <span class="header-word gradient-text-animated" style="--i:5">afición.</span>
      </h1> 
    </div>

    <div class="header-badge">
      <RoleBadge texto="Desarrollador Apps Multiplataforma" />
    </div>

    <div class="header-cta flex flex-wrap gap-3 mt-2">
      <a href="#destacados" class="group inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-fuchsia-600 text-white font-medium zilla-slab-regular hover:bg-fuchsia-500 hover:shadow-[0_0_40px_rgba(217,70,239,0.5)] hover:-translate-y-0.5 transition-all duration-300 relative overflow-hidden">
        <span class="relative z-10 flex items-center gap-2">
          Ver proyectos
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform duration-300">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </span>
        <span class="absolute inset-0 bg-gradient-to-r from-fuchsia-600 via-purple-500 to-fuchsia-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></span>
      </a>
      <a href="#contacto" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border border-slate-300 dark:border-white/15 text-slate-700 dark:text-white/80 font-medium zilla-slab-regular hover:border-fuchsia-400 dark:hover:border-fuchsia-500/40 hover:text-fuchsia-600 dark:hover:text-fuchsia-300 hover:shadow-[0_0_25px_rgba(217,70,239,0.15)] hover:-translate-y-0.5 transition-all duration-300 backdrop-blur-sm">
        Contactar
      </a>
    </div>
  </div>

</header>

<style>
  .header-name {
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }

  .header-title {
    opacity: 0;
  }

  .header-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(30px);
    animation: wordReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.4s + var(--i) * 0.08s);
  }

  @keyframes wordReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .header-badge {
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1s forwards;
  }

  .header-cta {
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1.2s forwards;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
