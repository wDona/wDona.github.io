---
import T from "../Common/T.astro";
import RoleBadge from "./Header/RoleBadge.astro";
import SectionBlobs from "../Common/Decoracion/SectionBlobs.astro";
---

<header class="min-h-screen w-full flex items-center justify-center relative overflow-x-clip" role="banner">
  <SectionBlobs variant="fuchsia" />
  <div class="hero-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="hero-aurora absolute pointer-events-none" aria-hidden="true"></div>
  
  <div class="relative z-10 flex flex-col items-start justify-center text-left px-4 sm:px-6 w-full max-w-5xl mx-auto gap-6 sm:gap-8 mt-16 sm:mt-0">
    
    <div class="flex flex-col items-start gap-3 max-w-4xl">
      <p class="text-2xl sm:text-3xl font-medium tracking-tight zilla-slab-regular header-name">
        <span class="font-bold text-slate-800 dark:text-white">wDona</span>
      </p> 
      
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight zilla-slab-regular text-pretty text-slate-800 dark:text-white header-title leading-[1.1]">
        <span class="header-word" style="--i:0"><span class="gradient-text-animated"><T es="Perfeccionista" en="Perfectionist" /></span></span>
        <span class="header-word" style="--i:1"><T es="por" en="by" /></span>
        <span class="header-word" style="--i:2"><T es="vocación," en="vocation," /></span>
        <br class="hidden sm:block" />
        <span class="header-word" style="--i:3"><span class="gradient-text-animated"><T es="explorador" en="explorer" /></span></span>
        <span class="header-word" style="--i:4"><T es="por" en="by" /></span>
        <span class="header-word" style="--i:5"><T es="afición." en="passion." /></span>
      </h1> 
    </div>

    <div class="header-badge">
      <RoleBadge texto="Desarrollador Apps Multiplataforma" textoEn="Cross-Platform App Developer" />
    </div>

    <div class="header-cta flex flex-wrap gap-3 mt-2">
      <a href="#destacados" class="btn btn-primary">
        <T es="Ver proyectos" en="View projects" />
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="#contacto" class="btn btn-ghost">
        <T es="Contactar" en="Get in touch" />
      </a>
    </div>
  </div>

  <a href="#experiencia" class="hero-scroll absolute bottom-8 left-1/2 -translate-x-1/2 hidden sm:flex p-2 text-slate-400 dark:text-white/40 hover:text-fuchsia-500 dark:hover:text-fuchsia-400 transition-colors duration-300" aria-label="Bajar a experiencia" data-en-aria-label="Scroll to experience">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </a>
</header>

<style>
  .header-name {
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }


  .header-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(30px);
    filter: blur(8px);
    animation: wordReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.4s + var(--i) * 0.08s);
  }

  @keyframes wordReveal {
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* Grid pattern faded toward the edges */
  .hero-grid {
    background-image:
      linear-gradient(to right, rgb(var(--c-fuchsia-500) / 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(var(--c-fuchsia-500) / 0.08) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 30%, transparent 75%);
  }

  /* Slowly rotating conic aurora behind the title */
  .hero-aurora {
    top: 50%;
    left: 50%;
    width: min(900px, 120vw);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: conic-gradient(from 0deg, rgb(var(--c-fuchsia-500) / 0.18), rgb(var(--c-indigo-500) / 0.12), rgb(var(--c-purple-500) / 0.18), rgb(var(--c-fuchsia-400) / 0.12), rgb(var(--c-fuchsia-500) / 0.18));
    mask-image: radial-gradient(closest-side, #000, transparent);
    -webkit-mask-image: radial-gradient(closest-side, #000, transparent);
    animation: auroraSpin 24s linear infinite;
  }
  :global(html:not(.dark)) .hero-grid {
    background-image:
      linear-gradient(to right, rgba(15, 23, 42, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15, 23, 42, 0.045) 1px, transparent 1px);
  }
  :global(html:not(.dark)) .hero-aurora {
    opacity: 0.3;
  }
  :global(html:not(.dark):not([data-palette="mono"])) .hero-grid {
    background-image:
      linear-gradient(to right, rgb(var(--c-fuchsia-500) / 0.09) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(var(--c-fuchsia-500) / 0.09) 1px, transparent 1px);
  }
  :global(html:not(.dark):not([data-palette="mono"])) .hero-aurora {
    opacity: 0.75;
  }
  @keyframes auroraSpin {
    to { rotate: 360deg; }
  }

  .hero-scroll {
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1.6s forwards;
  }
  .hero-scroll svg {
    animation: arrowBob 2s ease-in-out infinite;
  }
  @keyframes arrowBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  .header-badge {
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1s forwards;
  }

  .header-cta {
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1.2s forwards;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
