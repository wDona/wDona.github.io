---
import T from "../Common/T.astro";
---

<section class="intro" aria-labelledby="intro-titulo">
  <img
    src="/img/yo-y-gata.webp"
    alt="Fernando con su gata"
    data-en-alt="Fernando with his cat"
    class="foto"
    width="326"
    height="326"
    fetchpriority="high"
  />
  <div>
    <p class="meta">wDona</p>
    <h1 id="intro-titulo">Fernando de Cisneros</h1>
    <p class="role">
      <T es="Desarrollador de apps multiplataforma" en="Cross-platform app developer" />
      <span class="muted">· Kotlin, Java, Rust</span>
    </p>
    <ul class="meta links">
      <li><a href="mailto:me@wdona.dev">me@wdona.dev</a></li>
      <li><a href="https://github.com/wDona" target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a href="/linkedin" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><T es="España" en="Spain" /></li>
    </ul>
  </div>
</section>

<style>
  .intro {
    display: flex;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 2.5rem 0;
  }
  .foto {
    flex-shrink: 0;
    width: 5.5rem;
    height: 5.5rem;
    object-fit: cover;
    border: 3px solid rgb(var(--on-accent));
    border-radius: 6px;
  }
  h1 {
    margin-top: 0.4rem;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .role { margin-top: 0.5rem; font-size: 1.2rem; }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
  }
  @media (min-width: 768px) {
    .intro { align-items: center; padding: 3.5rem 0; }
    .foto { width: 13rem; height: 13rem; }
  }
</style>
