---
interface Props {
	title: string;
	timeRange?: string;
	tags?: string[];
	isLast?: boolean;
	accent?: 'active' | 'past';
}

const { title, timeRange, tags, isLast = false, accent = 'past' } = Astro.props;

const accentBar = accent === 'active'
  ? 'bg-fuchsia-500 dark:bg-fuchsia-400 shadow-[0_0_10px_rgba(217,70,239,0.3)] dark:shadow-[0_0_14px_rgba(217,70,239,0.4)]'
  : 'bg-slate-300 dark:bg-white/15';

const marginBottom = isLast ? 'mb-0' : 'mb-6';
---

<article class={`relative pl-6 ${marginBottom} reveal`} data-reveal-delay="100">
  <div class={`absolute left-0 top-1.5 w-[2px] h-[calc(100%-0.75rem)] rounded-full ${accentBar}`}></div>

  <div class="flex flex-col gap-1.5">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-3xl font-semibold text-slate-800 dark:text-white/90 tracking-tight">{title}</h3>
      {timeRange && (
        <span class="text-base text-fuchsia-600 dark:text-fuchsia-400">{timeRange}</span>
      )}
    </div>

    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-3">
        {tags.map((tag) => (
          <span class="text-base text-slate-500 dark:text-white/40">{tag}</span>
        ))}
      </div>
    )}

    <div class="text-lg text-slate-600 dark:text-white/60 font-light leading-relaxed mt-1">
      <slot />
    </div>
  </div>
</article>
