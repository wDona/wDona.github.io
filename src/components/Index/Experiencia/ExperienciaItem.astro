---
import T from "../../Common/T.astro";
interface Props {
	title: string;
	titleEn?: string;
	org?: string;
	timeRange?: string;
	timeRangeEn?: string;
	tags?: string[];
	tagsEn?: string[];
}

const { title, titleEn, org, timeRange, timeRangeEn, tags, tagsEn } = Astro.props;
---

<article class="item">
  <p class="meta">{timeRange && <T es={timeRange} en={timeRangeEn} />}</p>
  <div>
    <h3 class="text-xl">
      <T es={title} en={titleEn} />{org && <span class="muted font-normal">, {org}</span>}
    </h3>
    {tags && tags.length > 0 && (
      <p class="meta mt-1">
        {tags.map((tag, i) => <>{i > 0 && " · "}<T es={tag} en={tagsEn?.[i]} /></>)}
      </p>
    )}
    <div class="mt-2 empty:hidden">
      <slot />
    </div>
  </div>
</article>

<style>
  .item {
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem 0;
    border-top: 1px solid rgb(var(--rule));
  }
  .item:first-child { border-top: 0; padding-top: 0; }
  @media (min-width: 640px) {
    .item { grid-template-columns: 8rem 1fr; gap: 1.5rem; }
    .item > .meta { padding-top: 0.3rem; }
  }
</style>
