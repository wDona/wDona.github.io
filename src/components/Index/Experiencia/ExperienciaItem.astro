---
interface Props {
	title: string;
	timeRange?: string;
	tags?: string[];
	showLine?: boolean;
	isLast?: boolean;
}

const { title, timeRange, tags, showLine = false, isLast = false } = Astro.props;
---

<div class={`${isLast ? 'mb-10 mt-8' : 'mb-12'} ml-6 sm:ml-8 relative reveal`} data-reveal-delay="100">
  {showLine && (
    <div class="absolute -left-6 sm:-left-8 top-5 w-px h-[calc(100%+2rem)] bg-gradient-to-b from-fuchsia-300 dark:from-white/10 to-fuchsia-600 dark:to-fuchsia-400 transform -translate-x-1/2 z-0"></div>
  )}
  <span class={`absolute -left-6 sm:-left-8 top-5 w-4 h-4 rounded-full bg-white dark:bg-[#080808] border-2 ${isLast ? 'border-fuchsia-500 dark:border-fuchsia-400 shadow-[0_0_10px_rgba(217,70,239,0.2)] dark:shadow-[0_0_10px_rgba(217,70,239,0.5)]' : 'border-fuchsia-300 dark:border-white/40'} transform -translate-x-1/2 z-10`}></span>
  <article class="relative flex flex-col bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-3xl p-6 shadow-sm dark:shadow-none hover:bg-slate-50 dark:hover:bg-white/10 transition-colors duration-300">
    
    <div class={`border-b border-slate-200 dark:border-white/10 pb-3 ${tags ? 'mb-5' : 'mb-4'}`}>
      <h3 class="text-xl font-medium text-slate-800 dark:text-white/90 zilla-slab-regular">{title}</h3>
      {timeRange && (
        <time class="block mt-2 text-xs text-slate-500 dark:text-white/50 bg-slate-100 dark:bg-white/5 inline-block px-2 py-0.5 rounded shadow-sm w-max border border-slate-200 dark:border-transparent">{timeRange}</time>
      )}
      {tags && tags.length > 0 && (
        <div class="flex gap-2 mt-3">
          {tags.map((tag) => (
            <span class="text-xs text-slate-500 dark:text-white/50 bg-slate-100 dark:bg-white/5 inline-block px-2 py-0.5 rounded shadow-sm w-max border border-slate-200 dark:border-white/10">{tag}</span>
          ))}
        </div>
      )}
    </div>

    <div class="flex flex-col gap-4">
      <slot />
    </div>
  </article>
</div>
