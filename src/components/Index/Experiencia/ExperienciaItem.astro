---
import T from "../../Common/T.astro";
interface Props {
	title: string;
	titleEn?: string;
	timeRange?: string;
	timeRangeEn?: string;
	tags?: string[];
	tagsEn?: string[];
	isLast?: boolean;
	accent?: 'active' | 'past';
}

const { title, titleEn, timeRange, timeRangeEn, tags, tagsEn, isLast = false, accent = 'past' } = Astro.props;

const accentBar = accent === 'active'
  ? 'bg-fuchsia-500 dark:bg-fuchsia-400 shadow-[0_0_10px_rgb(var(--c-fuchsia-500)/0.3)] dark:shadow-[0_0_14px_rgb(var(--c-fuchsia-500)/0.4)]'
  : 'bg-slate-300 dark:bg-white/15';

const dot = accent === 'active'
  ? 'bg-fuchsia-500 dark:bg-fuchsia-400 ring-4 ring-fuchsia-500/20'
  : 'bg-white dark:bg-[rgb(5,5,8)] border-2 border-slate-300 dark:border-white/25';

const marginBottom = isLast ? 'mb-0' : 'mb-6';
---

<article class={`group relative pl-8 ${marginBottom} reveal`} data-reveal-delay="100">
  {!isLast && <div class={`absolute left-[5px] top-6 w-[2px] h-[calc(100%-0.5rem)] rounded-full ${accentBar}`} aria-hidden="true"></div>}
  <span class="absolute left-0 top-3 flex h-3 w-3" aria-hidden="true">
    {accent === 'active' && <span class="absolute inline-flex h-full w-full rounded-full bg-fuchsia-400 opacity-60 animate-ping"></span>}
    <span class={`relative inline-flex h-3 w-3 rounded-full transition-transform duration-300 group-hover:scale-125 ${dot}`}></span>
  </span>

  <div class="flex flex-col gap-1.5">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-3xl font-semibold text-slate-800 dark:text-white/90 tracking-tight transition-colors duration-300 group-hover:text-fuchsia-600 dark:group-hover:text-fuchsia-300"><T es={title} en={titleEn} /></h3>
      {timeRange && (
        <span class="text-base text-fuchsia-600 dark:text-fuchsia-400"><T es={timeRange} en={timeRangeEn} /></span>
      )}
    </div>

    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-3">
        {tags.map((tag, i) => (
          <span class="text-base text-slate-500 dark:text-white/40"><T es={tag} en={tagsEn?.[i]} /></span>
        ))}
      </div>
    )}

    <div class="text-lg text-slate-600 dark:text-white/60 font-light leading-relaxed mt-1">
      <slot />
    </div>
  </div>
</article>
