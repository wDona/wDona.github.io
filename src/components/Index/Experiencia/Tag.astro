---
interface Props {
  color?: 'indigo' | 'emerald' | 'fuchsia' | 'slate';
}

const { color = 'slate' } = Astro.props;

const colorMap = {
  indigo: "text-indigo-600 dark:text-indigo-400",
  emerald: "text-emerald-600 dark:text-emerald-400",
  fuchsia: "text-fuchsia-600 dark:text-fuchsia-400",
  slate: "text-slate-500 dark:text-white/40"
};
---

<span class={`inline-flex items-center gap-1.5 text-sm ${colorMap[color]}`}>
  <slot />
</span>
