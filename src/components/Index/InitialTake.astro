  >
    <div class="flex sm:justify-center items-center sm:gap-8 gap-4 flex-col-reverse sm:flex-row">
      <!-- <h2 class="text-lg mb-2 zilla-slab-regular text-center opacity-80">¿Quién soy?</h2> -->
      <!-- <div class="flex justify-center items-center">
        <BotonSecundario texto="Sobre mí" enlace="https://wdona.dev/sobre-mi" />
      </div> -->
