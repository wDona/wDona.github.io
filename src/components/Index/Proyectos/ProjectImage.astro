---
// Project picture inside a thin frame: drawn cover, screenshot, or an empty frame.
import ProjectCover from "./ProjectCover.astro";

interface Props {
  img?: string;
  cover?: "chat" | "interprete" | "todo" | "impostor" | "burntout";
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
}
const { img, cover, alt, class: cls = "", loading = "lazy" } = Astro.props;
const src = (p: string) => (p.startsWith("/") || p.startsWith("http") ? p : "/" + p);
---

<span class={`frame ${cls}`}>
  {cover ? <ProjectCover name={cover} /> : img && <img src={src(img)} alt={alt} loading={loading} />}
</span>
