---
// One row of the "other projects" list
import T from "../../Common/T.astro";
import ProjectImage from "./ProjectImage.astro";
import Plataformas from "./Plataformas.astro";
import TechList from "./TechList.astro";

interface Props {
  id: string;
  title: string;
  titleEn?: string;
  link: string;
  linkdescarga?: string;
  img?: string;
  cover?: "chat" | "interprete" | "todo" | "impostor" | "burntout";
  tecnologias?: Array<{ name: string; img: string }>;
  summary?: string;
  summaryEn?: string;
  plataformas?: Array<"linux" | "windows" | "android" | "ios" | "web">;
}
const { id, title, titleEn, link, linkdescarga, img, cover, tecnologias = [], plataformas } = Astro.props;
---

<article class="row">
  <a href={`/proyectos/${id}`} class="thumb" tabindex="-1" aria-hidden="true">
    <ProjectImage img={img} cover={cover} alt="" class="aspect-video" />
  </a>
  <div class="min-w-0">
    <h4 class="text-lg"><a href={`/proyectos/${id}`} class="plain"><T es={title} en={titleEn} /></a></h4>
    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
      <TechList tecnologias={tecnologias} />
      <Plataformas plataformas={plataformas} />
      {linkdescarga && (
        <a href={linkdescarga} data-release-repo={link} target="_blank" rel="noopener noreferrer" class="meta">
          <T es="Descargar" en="Download" />
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    align-items: start;
  }
  @media (min-width: 640px) { .row { grid-template-columns: 10rem 1fr; gap: 1.25rem; } }
</style>
