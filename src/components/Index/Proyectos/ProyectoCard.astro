---
import BotonPrimario from "../../Common/BotonPrimario.astro";
import LenguajeLabel from "./LenguajeLabel.astro";

interface Props {
  id?: string;
  highlight?: boolean;
  title: string;
  link: string;
  linkdescarga?: string;
  img?: string;
  tecnologias?: Array<{ name: string; img: string }>;
  summary?: string;
}
const { title, highlight, linkdescarga, img } = Astro.props;
const id = Astro.props.id || title.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
const tecnologias = Astro.props.tecnologias ?? [];

const alt = "Imagen de " + title.toLowerCase();
---

<div class:list={[
    "relative flex flex-col group rounded-2xl overflow-hidden h-full transition-transform duration-300 hover:scale-[1.02]",
    highlight
      ? "bg-white dark:bg-[#0d0008]/60 border border-fuchsia-300 dark:border-fuchsia-500/40 shadow-[0_0_20px_rgba(217,70,239,0.1)] dark:shadow-[0_0_30px_rgba(217,70,239,0.18)] hover:border-fuchsia-500/60 dark:hover:border-fuchsia-400/60 hover:shadow-[0_0_30px_rgba(217,70,239,0.2)] dark:hover:shadow-[0_0_45px_rgba(217,70,239,0.30)]"
      : "bg-slate-50 dark:bg-[#080808]/50 border border-slate-200 dark:border-white/5 shadow-sm hover:border-fuchsia-400/50 dark:hover:border-fuchsia-500/30 hover:shadow-[0_0_15px_rgba(217,70,239,0.1)] dark:hover:shadow-[0_0_25px_rgba(217,70,239,0.15)]"
  ]}
>
  <!-- Enlace oculto que cubre toda la tarjeta -->
  <a href={`/proyectos/${id}`} class="absolute inset-0 z-0" aria-label={`Ver detalles de ${title}`}></a>

  {highlight && (
    <div class="absolute top-3 left-3 z-20 pointer-events-none">
      <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold bg-fuchsia-500/90 text-white backdrop-blur-sm shadow-[0_0_12px_rgba(217,70,239,0.5)]">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Destacado
      </span>
    </div>
  )}

  <!-- Miniatura del video (Aspect ratio 16:9) -->
  <div class="relative w-full aspect-video bg-slate-100 dark:bg-black rounded-t-2xl overflow-hidden border-b border-slate-200 dark:border-white/5 z-10 pointer-events-none">
    {img ? (
      <img
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        src={img}
        alt={alt}
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-gray-500">
        <svg class="w-16 h-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2.5" y="4" width="19" height="14" rx="2"></rect>
          <path d="M3.5 18.5l5.5-6 4 5.5 5-7 1.5 2.5"></path>
          <circle cx="8.5" cy="9" r="1.2"></circle>
        </svg>
      </div>
    )}
  </div>

  <!-- Detalles del proyecto (Debajo de la miniatura) -->
  <div class="p-4 flex flex-col flex-grow relative z-10 pointer-events-none">
    
    <!-- Título -->
    <h3 class="text-xl sm:text-2xl font-bold mb-2 text-slate-800 dark:text-white group-hover:text-fuchsia-600 dark:group-hover:text-fuchsia-300 transition-colors duration-300 line-clamp-2">
      {title}
    </h3>
    
    <!-- Lenguajes -->
    <div class="flex flex-wrap gap-2 mb-3">
      {tecnologias.map(tec => <LenguajeLabel img={tec.img} name={tec.name} />)}
    </div>

    <!-- Botón de descarga al final -->
    <div class="mt-auto pt-4 pointer-events-auto relative z-20">
      {linkdescarga && (
        <BotonPrimario texto="Descargar" enlace={linkdescarga} id={`btn-descarga-card-${id}`} />
      )}
    </div>
  </div>
</div>

<script is:inline define:vars={{ cardId: id, repoLink: Astro.props.link }}>
  const btnDescarga = document.getElementById(`btn-descarga-card-${cardId}`);

  if (btnDescarga && repoLink) {
    const githubMatch = repoLink.match(/github\.com\/([^\/]+)\/([^\/]+)/);
    
    if (githubMatch) {
      const owner = githubMatch[1];
      const repo = githubMatch[2];
      const apiUrl = `https://api.github.com/repos/${owner}/${repo}/releases`;

      fetch(apiUrl, { cache: "no-store" })
        .then(res => res.json())
        .then(releases => {
          if (releases && releases.length > 0) {
            btnDescarga.setAttribute("href", releases[0].html_url);
          }
        })
        .catch(err => console.error(`Error obteniendo releases para ${repo}:`, err));
    }
  }
</script>
