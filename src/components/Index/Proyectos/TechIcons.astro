---
interface Props {
  tecnologias: Array<{ name: string; img: string }>;
}
const { tecnologias } = Astro.props;
---

{tecnologias.length > 0 && (
  <ul class="absolute bottom-3 left-3 right-3 z-10 flex flex-wrap justify-end gap-1.5 max-h-[70px] overflow-hidden" aria-label="Tecnologías" data-en-aria-label="Technologies">
    {tecnologias.map(tec => (
      <li
        class="h-8 w-8"
        title={tec.name}
      >
        <img src={"/" + tec.img} alt={tec.name} class="h-full w-full object-contain drop-shadow-[0_2px_6px_rgba(0,0,0,0.6)]" loading="lazy" />
      </li>
    ))}
  </ul>
)}
