---
interface Props {
  img?: string;
  alt?: string;
}
const img = Astro.props.img;
const text = img?.substring(img.lastIndexOf('/') + 1, img.lastIndexOf('logo')).replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) ?? '';
const alt = Astro.props.alt ?? text;
---
<span
  class="inline-flex items-center gap-2 rounded-full p-2 lg:px-3 lg:py-2 text-sm font-medium zilla-slab-regular bg-white/4 border border-white/50 "
>
  {img ? (
    <img src={img} alt={alt} class="w-5 h-5 object-cover flex-shrink-0" loading="lazy" />
  ) : (
    <svg class="w-5 h-5 text-gray-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="14" rx="3"></rect>
      <path d="M3 18l6-6 4 5 6-8"></path>
    </svg>
  )}
  <span class="hidden lg:block truncate">{text}</span>
</span>