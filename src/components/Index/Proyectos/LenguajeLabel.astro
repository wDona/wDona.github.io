---
interface Props {
  img?: string;
  alt?: string;
  name?: string;
}
const img = Astro.props.img;
const derivedText = img?.substring(img.lastIndexOf('/') + 1, img.lastIndexOf('logo')).replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) ?? '';
const text = Astro.props.name ?? derivedText;
const alt = Astro.props.alt ?? text;
---
<span
  class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-sm font-medium zilla-slab-regular bg-fuchsia-950/40 border border-fuchsia-500/20 text-fuchsia-200/80"
>
  {img ? (
    <img src={img} alt={alt} class="w-5 h-5 object-contain flex-shrink-0" loading="lazy" />
  ) : (
    <svg class="w-5 h-5 flex-shrink-0 text-fuchsia-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="14" rx="3"></rect>
      <path d="M3 18l6-6 4 5 6-8"></path>
    </svg>
  )}
  <span class="hidden lg:block truncate">{text}</span>
</span>