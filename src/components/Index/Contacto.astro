---
import T from "../Common/T.astro";
const EMAIL = "me@wdona.dev";
---
<section class="sec" id="contacto" aria-labelledby="contacto-titulo">
  <h2 id="contacto-titulo"><T es="Contacto" en="Contact" /></h2>
  <div>

    <dl class="contact-list">
      <dt class="meta"><T es="Correo" en="Email" /></dt>
      <dd>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <button type="button" id="copyEmail" class="toggle ml-3" data-email={EMAIL}>
          <span class="copy-label"><T es="copiar" en="copy" /></span>
          <span class="copied-label" hidden><T es="copiado" en="copied" /></span>
        </button>
      </dd>
      <dt class="meta">LinkedIn</dt>
      <dd><a href="/linkedin" target="_blank" rel="noopener noreferrer">Fernando de Cisneros González</a></dd>
      <dt class="meta">GitHub</dt>
      <dd><a href="https://github.com/wDona" target="_blank" rel="noopener noreferrer">github.com/wDona</a></dd>
    </dl>
    <p id="copyHint" role="status" aria-live="polite" class="meta mt-3 min-h-[1.25rem]"></p>
  </div>
</section>

<style>
  .contact-list {
    display: grid;
    grid-template-columns: 6rem 1fr;
    max-width: 36rem;
  }
  .contact-list > * {
    padding: 0.6rem 0;
    border-top: 1px solid rgb(var(--rule));
  }
  .contact-list dt { padding-top: 0.8rem; }
</style>

<script>
  // Footer (and this section) is on every page: listen once on the document
  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest?.<HTMLButtonElement>("#copyEmail");
    if (!btn) return;
    const hint = document.getElementById("copyHint")!;
    const [label, copied] = [btn.querySelector<HTMLElement>(".copy-label")!, btn.querySelector<HTMLElement>(".copied-label")!];
    try {
      await navigator.clipboard.writeText(btn.dataset.email!);
      label.hidden = true;
      copied.hidden = false;
      setTimeout(() => { label.hidden = false; copied.hidden = true; }, 2500);
    } catch {
      hint.innerHTML = `<span data-l="es">No se pudo copiar. Usa el enlace del correo.</span><span data-l="en">Couldn't copy. Use the email link.</span>`;
    }
  });
</script>
