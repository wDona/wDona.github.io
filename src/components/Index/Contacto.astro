---
import BotonSecundario from "../Common/BotonSecundario.astro";
const EMAIL = "me@wdona.dev";
const LINKEDIN = "https://www.linkedin.com/in/fernando-de-cisneros-gonzález-2b575b388";
---
<section class="w-full flex flex-col items-center gap-6 py-6" id="contacto">
  <div class="flex flex-col items-center gap-2 text-center reveal">
        <h2 class="text-3xl sm:text-4xl font-bold zilla-slab-regular text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-400 to-fuchsia-100">¿Hablamos?</h2>
    <p class="text-white/70 max-w-lg zilla-slab-regular text-sm sm:text-base">Siempre estoy abierto a nuevas oportunidades y colaboraciones. Si tienes algún proyecto en mente o simplemente quieres saludar, no dudes en contactarme.</p>
  </div>

  <div class="flex flex-col sm:flex-row gap-4 justify-center items-center font-sans tracking-wide reveal" data-reveal-delay="150">
    <a id="copyEmail" role="button" aria-live="polite"
       class="cursor-pointer bg-fuchsia-900/40 border-[1px] border-fuchsia-700/50 text-white px-6 py-2 rounded-lg hover:bg-fuchsia-800 hover:-translate-y-1 hover:shadow-[0_0_15px_rgba(134,25,143,0.4)] transition-all duration-300 w-full sm:w-auto text-center font-medium backdrop-blur-sm">
       Copiar correo
    </a>

    <BotonSecundario texto="Enviar correo" enlace={`mailto:${EMAIL}`} />

    <BotonSecundario texto="LinkedIn" enlace={LINKEDIN} />
  </div>

  <p id="copyHint" class="text-sm font-medium zilla-slab-regular text-fuchsia-400 opacity-0 transition-opacity duration-300 h-2 -mt-2">¡Correo copiado al portapapeles!</p>
</section>

<script is:inline type="module">
  const email = "me@wdona.dev";
  const copyBtn = document.getElementById("copyEmail");
  const hint = document.getElementById("copyHint");

  if (copyBtn && hint) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
        
        // Efecto visual
        const originalText = "Copiar correo";
        copyBtn.innerText = "¡Copiado!";
        copyBtn.classList.replace("bg-fuchsia-900/40", "bg-green-700/60");
        copyBtn.classList.replace("border-fuchsia-700/50", "border-green-500/50");
        copyBtn.style.pointerEvents = "none";
        
        hint.classList.remove("opacity-0");
        hint.classList.add("opacity-100");

        // Restaurar estado después de 2.5 segundos
        setTimeout(() => {
          copyBtn.innerText = originalText;
          copyBtn.classList.replace("bg-green-700/60", "bg-fuchsia-900/40");
          copyBtn.classList.replace("border-green-500/50", "border-fuchsia-700/50");
          copyBtn.style.pointerEvents = "auto";

          hint.classList.remove("opacity-100");
          hint.classList.add("opacity-0");
        }, 2500);
      } catch (e) {
        hint.textContent = "No se pudo copiar. Usa 'Enviar correo'.";
        hint.classList.replace("text-fuchsia-400", "text-red-400");
        hint.classList.remove("opacity-0");
        hint.classList.add("opacity-100");
      }
    });
  }
</script>

<style>
    .gradient-border {
    position: relative;
    display: inline-block;
    border-radius: 0.5rem;
    background: transparent;
  }
  
  .gradient-border::before {
    content: "";
    position: absolute;
    inset: 0;
    padding: 2px;
    border-radius: inherit;
    background: linear-gradient(to right, #a855f7, #ec4899, #ef4444);
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
  }

</style>