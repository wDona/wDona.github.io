---
const EMAIL = "me@wdona.dev";
const LINKEDIN = "/linkedin";
---
<section class="relative w-full py-10" id="contacto" aria-labelledby="contacto-titulo">
  <h2 id="contacto-titulo" class="section-title reveal">¿Hablamos?</h2>
  <div class="reveal mx-auto max-w-3xl px-2 text-center" data-reveal-delay="100">
      <p class="mx-auto max-w-lg text-slate-600 dark:text-white/70 zilla-slab-regular text-base sm:text-lg">Siempre estoy abierto a nuevas oportunidades y colaboraciones. Si tienes algún proyecto en mente o simplemente quieres saludar, no dudes en contactarme.</p>

      <div class="relative mt-8 flex flex-col sm:flex-row flex-wrap gap-3 justify-center items-stretch sm:items-center">
        <a href={`mailto:${EMAIL}`} class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Enviar correo
        </a>

        <button id="copyEmail" type="button" class="btn btn-ghost">
          <svg class="icon-copy" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <svg class="icon-check hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span class="copy-label">Copiar correo</span>
        </button>

        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
          LinkedIn
        </a>
      </div>

      <p id="copyHint" role="status" aria-live="polite" class="relative mt-4 h-5 text-sm font-medium zilla-slab-regular text-emerald-600 dark:text-emerald-400 opacity-0 transition-opacity duration-300">¡Correo copiado al portapapeles!</p>
  </div>
</section>

<script is:inline type="module">
  const email = "me@wdona.dev";
  const copyBtn = document.getElementById("copyEmail");
  const hint = document.getElementById("copyHint");

  if (copyBtn && hint) {
    const label = copyBtn.querySelector(".copy-label");
    const iconCopy = copyBtn.querySelector(".icon-copy");
    const iconCheck = copyBtn.querySelector(".icon-check");

    const setCopied = (copied) => {
      copyBtn.classList.toggle("btn-success", copied);
      copyBtn.disabled = copied;
      label.textContent = copied ? "¡Copiado!" : "Copiar correo";
      iconCopy.classList.toggle("hidden", copied);
      iconCheck.classList.toggle("hidden", !copied);
      hint.classList.toggle("opacity-0", !copied);
    };

    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
        setCopied(true);
        setTimeout(() => setCopied(false), 2500);
      } catch (e) {
        hint.textContent = "No se pudo copiar. Usa 'Enviar correo'.";
        hint.classList.replace("text-emerald-600", "text-red-500");
        hint.classList.replace("dark:text-emerald-400", "dark:text-red-400");
        hint.classList.remove("opacity-0");
      }
    });
  }
</script>
